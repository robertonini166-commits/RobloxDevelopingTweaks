local function boxed(tab, opts)
    opts = opts or {}; opts.Box = true; opts.BoxBorder = true
    if opts.Opened == nil then opts.Opened = true end
    local okS, sec = pcall(function() return tab:Section(opts) end)
    if okS and type(sec) == "table" and type(sec.Button) == "function" then return sec end
    pcall(function() tab:Section({ Title = opts.Title }) end)
    return tab
end

