    Title = "Name or UserId",
    Placeholder = "e.g. Builderman or 156",
    Callback = function(v) typedName = v end,
})

-- Preview paragraph + injected headshot image
local previewPara = gInput:Paragraph({ Title = "No player loaded", Desc = "Type a name and press Preview." })

local function previewImgLabel()
    local ui = previewPara and previewPara.ParagraphFrame and previewPara.ParagraphFrame.UIElements
    local anchor = ui and (ui.Title or ui.Desc)
    if not (anchor and typeof(anchor) == "Instance") then return nil end
    local pf = anchor.Parent
    while pf and not (pf:IsA("Frame") or pf:IsA("ImageButton") or pf:IsA("ImageLabel")) do pf = pf.Parent end
    if not pf then return nil end
    local lbl = pf:FindFirstChild("SkinSwapImg")
    if not lbl then
        lbl = Instance.new("ImageLabel")
        lbl.Name = "SkinSwapImg"
        lbl.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
        lbl.BackgroundTransparency = 0.2
        lbl.BorderSizePixel = 0
        lbl.AnchorPoint = Vector2.new(1, 0.5)
        lbl.Position = UDim2.new(1, -10, 0.5, 0)
        lbl.Size = UDim2.fromOffset(64, 64)
        lbl.ScaleType = Enum.ScaleType.Fit
        lbl.ZIndex = 20
        lbl.Parent = pf
        Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 8)
    end
    return lbl
end

local previewUserId, previewName
local function doPreview()
    local id, nameOrErr = resolveUser(typedName)
    if not id then notify("Skin Swap", nameOrErr, "solar:close-circle-bold") return end
    previewUserId, previewName = id, nameOrErr
    prefetch(id)  -- warm caches while the user looks at the photo
    local img = fetchHeadshot(id)
    pcall(function()
        local el = previewPara and previewPara.ParagraphFrame and previewPara.ParagraphFrame.UIElements
        if el then
            if el.Title then el.Title.Text = nameOrErr end
            if el.Desc then el.Desc.Text = "UserId: " .. id .. " - ready to load." end
        end
    end)
    pcall(function()
        local lbl = previewImgLabel()
        if lbl then lbl.Image = img; lbl.Visible = true end
    end)
end

gInput:Button({ Title = "Preview (load photo)", Icon = "solar:gallery-bold", Callback = function()
    task.spawn(doPreview)
end })

local gActions = boxed(Tab, { Title = "Apply", Desc = "Client-side only - copies look + animations.", Icon = "solar:magic-stick-3-bold" })

gActions:Button({ Title = "Load Avatar", Icon = "solar:user-check-bold", Callback = function()
    task.spawn(function()
