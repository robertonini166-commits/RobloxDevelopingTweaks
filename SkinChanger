            if not id then notify("Skin Swap", "Preview a player first.", "solar:close-circle-bold") return end
        end
        local ok, err = applyAvatar(id)
        if ok then
            lastUserId = id
            notify("Skin Swap", "Now wearing " .. (previewName or ("User " .. id)) .. "'s avatar", "solar:check-circle-bold")
        else
            notify("Skin Swap", err or "Failed", "solar:close-circle-bold")
        end
    end)
end })

gActions:Button({ Title = "Restore my avatar", Icon = "solar:refresh-bold", Callback = function()
    task.spawn(function()
        lastUserId = nil
        local ok, err = restoreAvatar()
        if ok then notify("Skin Swap", "Restored your real avatar", "solar:check-circle-bold")
        else notify("Skin Swap", err or "Nothing to restore", "solar:info-circle-bold") end
    end)
end })

-------------------------------------------------------------------------------
-- Favorites tab
--
-- One button per saved avatar. Clicking wears it; with "Remove mode" on, the
-- same click deletes it instead - a dropdown would need fewer elements but
-- WindUI's list refresh is fiddly, and rebuilding plain Buttons always works.
-------------------------------------------------------------------------------
local FavTab = Window:Tab({ Title = "Favorites", Icon = "solar:star-bold" })

local gFavAdd = boxed(FavTab, {
    Title = "Save",
    Desc  = canPersist() and "Stored in SkinSwap/favorites.json - survives rejoins."
                          or "This executor has no file access: session only.",
    Icon  = "solar:star-bold",
})

local gFavList = boxed(FavTab, { Title = "Saved avatars", Icon = "solar:users-group-rounded-bold" })

local removeMode = false
gFavList:Toggle({
    Title = "Remove mode",
    Desc  = "Clicking a favorite deletes it instead of wearing it.",
    Value = false,
    Callback = function(v) removeMode = v end,
})

local favElements, emptyPara = {}, nil
local rebuildFavList
rebuildFavList = function()
    for _, el in ipairs(favElements) do pcall(function() el:Destroy() end) end
    table.clear(favElements)

    if #favorites == 0 then
        if not emptyPara then
            emptyPara = gFavList:Paragraph({
                Title = "No favorites yet",
                Desc  = "Preview a player on the Skin tab, then press Save.",
            })
        end
        return
    end
    if emptyPara then
        pcall(function() emptyPara:Destroy() end)
        emptyPara = nil
    end

    for _, entry in ipairs(favorites) do
        local fav = entry -- captured per button
        local el = gFavList:Button({
            Title = fav.name,
            Desc  = "UserId: " .. fav.id,
            Icon  = "solar:user-bold",
            Callback = function()
                task.spawn(function()
                    if removeMode then
                        removeFavorite(fav.id)
                        rebuildFavList()
                        notify("Favorites", "Removed " .. fav.name, "solar:trash-bin-trash-bold")
                        return
                    end
                    local okFav, err = applyAvatar(fav.id)
                    if okFav then
                        lastUserId = fav.id
                        notify("Skin Swap", "Now wearing " .. fav.name .. "'s avatar", "solar:check-circle-bold")
                    else
                        notify("Skin Swap", err or "Failed", "solar:close-circle-bold")
                    end
                end)
            end,
        })
        table.insert(favElements, el)
    end

    -- Warm every saved avatar in the background, staggered so a big list
    -- doesn't fire a dozen web fetches at once. Clicking one is then instant.
    task.spawn(function()
        for _, fav in ipairs(favorites) do
            prefetch(fav.id)
            task.wait(0.5)
        end
    end)
end

gFavAdd:Button({
    Title = "Save current target",
    Icon  = "solar:star-bold",
    Callback = function()
        task.spawn(function()
            local id, name = previewUserId, previewName
            if not id then
                id, name = resolveUser(typedName)
                if not id then
                    notify("Favorites", "Preview or type a player first.", "solar:close-circle-bold")
                    return
                end
            end
            local okAdd, err = addFavorite(id, name)
            if not okAdd then
                notify("Favorites", err, "solar:info-circle-bold")
                return
            end
            rebuildFavList()
            notify("Favorites", "Saved " .. (name or ("User " .. id)), "solar:check-circle-bold")
        end)
    end,
})

rebuildFavList()

