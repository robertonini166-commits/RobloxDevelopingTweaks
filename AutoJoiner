-- ═══════════════════════════════════════════════════════════════════════
-- MESSAGE-ID DEDUP  (file-backed so duplicates survive restarts)
-- Prevents the same Discord message from being processed twice on
-- gateway reconnect, REST fallback or autoexec re-run.
-- ═══════════════════════════════════════════════════════════════════════
local JNUBS_FILE = "aj_jnubs.txt"
local _seenMsgIds = {}   -- in-memory; initialised from file at startup

pcall(function()
    local v = readfile(JNUBS_FILE)
    local t = HttpService:JSONDecode(v)
    if type(t) == "table" then
        for _, id in ipairs(t) do _seenMsgIds[id] = true end
    end
end)

local function isSeen(msgId)    return _seenMsgIds[tostring(msgId)] == true end

local _seenDirty, _seenFlushing = false, false
local function flushSeen()
    local t = {}
    for id in pairs(_seenMsgIds) do table.insert(t, id) end
    -- Numeric sort: snowflakes are 17-19 digits, so a plain string sort put the
    -- NEWER 19-digit IDs first and the cap below then evicted them instead of
    -- the old ones — dedup silently forgot everything recent.
    table.sort(t, function(a, b) return (tonumber(a) or 0) < (tonumber(b) or 0) end)
    while #t > 500 do table.remove(t, 1) end
    local keep = {}
    for _, id in ipairs(t) do keep[id] = true end
    for id in pairs(_seenMsgIds) do
        if not keep[id] then _seenMsgIds[id] = nil end
    end
    pcall(writefile, JNUBS_FILE, HttpService:JSONEncode(t))
end

local function markSeen(msgId)
    msgId = tostring(msgId)
    if _seenMsgIds[msgId] then return end
    _seenMsgIds[msgId] = true
    -- Debounced: a gateway burst used to rewrite the whole 500-entry file once
    -- per message. Now at most once every 10s.
    _seenDirty = true
    if _seenFlushing then return end
    _seenFlushing = true
    task.spawn(function()
        task.wait(10)
        _seenFlushing = false
        if _seenDirty then _seenDirty = false; pcall(flushSeen) end
    end)
end

