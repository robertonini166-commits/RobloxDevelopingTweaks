-- DEVICE SELECT / PLAY PROMPT
-- Handles two separate MM2 load screens:
--   1. DeviceSelect  — Tablet/Phone chooser (mobile)
--   2. Loading > Join > Friends > Play  — friend-server join prompt (PC + mobile)
-- ═══════════════════════════════════════════════════════════════════════
-- Game-owned ScreenGuis that must stay visible while we click through the
-- load screens. Everything else in PlayerGui is injected UI and gets hidden
-- for the duration of the click so it can't swallow the input.
local GAME_GUIS = {
    TradeGUI=true, TradeGUI_Phone=true, Scoreboard=true, Scoreboard_Phone=true,
    CrossPlatform=true, GameTopbar=true, InputContext=true, Fade=true, MainGUI=true,
    GameplayControlsUI=true, BackpackUI=true, SpawnFade=true, CameraFade=true,
    TouchInteractButtons=true, DeviceSelect=true, InteractGUI=true, Loading=true, Join=true,
    AJ_NoRender=true,
}

task.spawn(function()
    local UIS = game:GetService("UserInputService")
    local isMobile = UIS.TouchEnabled
    local VIM = game:GetService("VirtualInputManager")

    local function vimClick(btn)
        local t = 0
        while btn.AbsoluteSize.X == 0 and t < 3 do task.wait(0.05); t = t + 0.05 end
        if btn.AbsoluteSize.X == 0 then return false end
        pcall(function() btn:Activate() end)
        local pos, sz = btn.AbsolutePosition, btn.AbsoluteSize
        VIM:SendMouseButtonEvent(pos.X + sz.X/2, pos.Y + sz.Y/2, 0, true,  game, 1)
        task.wait(0.05)
        VIM:SendMouseButtonEvent(pos.X + sz.X/2, pos.Y + sz.Y/2, 0, false, game, 1)
        return true
    end

    local function hideInjectedGuis()
        local hidden = {}
        if isMobile then
            pcall(function()
                for _, gui in ipairs(LP.PlayerGui:GetChildren()) do
                    if gui:IsA("ScreenGui") and gui.Enabled and not GAME_GUIS[gui.Name] then
                        gui.Enabled = false; table.insert(hidden, gui)
                    end
                end
            end)
            task.wait(0.1)
        end
        return hidden
    end

    local function restoreGuis(hidden)
        if #hidden > 0 then
            task.wait(0.4)
            for _, gui in ipairs(hidden) do pcall(function() gui.Enabled = true end) end
        end
    end

    getgenv()._aj_vimDone = false
    local dsHandled = not isMobile   -- PC never needs DeviceSelect; mark done immediately
    local loadHandled = false
    local _startTime = tick()
    while task.wait(0.1) do
        -- Hold the clock until the place is loaded — on a slow join the prompts
        -- appear well after 15s and the old fixed deadline gave up too early.
        if not game:IsLoaded() then _startTime = tick() end
        local pg = LP.PlayerGui
        if dsHandled and loadHandled then break end
        local joinGui     = pg:FindFirstChild("Join")
        local joinFriends = joinGui and joinGui:FindFirstChild("Friends")
        local joinActive  = joinFriends and joinFriends.Visible == true
        if not pg:FindFirstChild("DeviceSelect") and not joinActive and tick() - _startTime > 5 then break end
        if tick() - _startTime > 15 then break end

        -- 1. DeviceSelect — Tablet/Phone chooser (mobile)
        if not dsHandled and pg:FindFirstChild("DeviceSelect") then
            local ds = pg:FindFirstChild("DeviceSelect")
            local Container = ds:WaitForChild("Container", 5)
            local btn
            local tabletCard = Container and Container:FindFirstChild("Tablet")
            btn = tabletCard and tabletCard:FindFirstChild("Button")
            if not btn then
                local phoneCard = Container and Container:FindFirstChild("Phone")
                btn = phoneCard and phoneCard:FindFirstChild("Button")
            end
            if btn then
                local hidden = hideInjectedGuis()
                for _, sigName in ipairs({"Activated", "MouseButton1Click", "MouseButton1Down"}) do
                    pcall(function()
                        for _, conn in ipairs(getconnections(btn[sigName])) do
                            pcall(conn.Function)
                        end
                    end)
                end
                pcall(function() btn:Activate() end)
                restoreGuis(hidden)
                dsHandled = true
            end
        end

        -- 2. Join > Friends > Play — "Joining a friend?" prompt (PC + mobile)
        if not loadHandled and joinActive then
            local btn = joinFriends:FindFirstChild("Play")
            if btn then
                local hidden = hideInjectedGuis()
                local clicked = vimClick(btn)
                restoreGuis(hidden)
                if clicked then loadHandled = true end
            end
        end
    end
    getgenv()._aj_vimDone = true
end)

