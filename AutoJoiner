-- ═══════════════════════════════════════════════════════════════════════
-- DEVICE SELECT / PLAY PROMPT
-- Handles two separate MM2 load screens:
--   1. DeviceSelect  — Tablet/Phone chooser (mobile)
--   2. Loading > Join > Friends > Play  — friend-server join prompt (PC + mobile)
-- ═══════════════════════════════════════════════════════════════════════
-- Game-owned ScreenGuis that must stay visible while we click through the
-- load screens. Everything else in PlayerGui is injected UI and gets hidden
-- for the duration of the click so it can't swallow the input.
local GAME_GUIS = {
    TradeGUI=true, TradeGUI_Phone=true, Scoreboard=true, Scoreboard_Phone=true,
    CrossPlatform=true, GameTopbar=true, InputContext=true, Fade=true, MainGUI=true,
    GameplayControlsUI=true, BackpackUI=true, SpawnFade=true, CameraFade=true,
    TouchInteractButtons=true, DeviceSelect=true, InteractGUI=true, Loading=true, Join=true,
    AJ_NoRender=true,
}

local UIS       = game:GetService("UserInputService")
local VIM       = game:GetService("VirtualInputManager")
local RunSvc    = game:GetService("RunService")
local IS_MOBILE = UIS.TouchEnabled

-- Set3dRenderingEnabled(false) halts the render step, and GUI layout rides on
-- it: AbsolutePosition/AbsoluteSize freeze and never update again. Every click
-- path below measures the button before clicking, so with no-render active they
-- all bail out and the prompt is never dismissed — that is the "stuck on device
-- select" hang. Anything that measures or clicks a prompt runs inside this.
local function withRender(fn)
    local hadNoRender = getgenv()._aj_norender
    if hadNoRender then pcall(function() RunSvc:Set3dRenderingEnabled(true) end) end
    local ok, err = pcall(fn)
    -- Re-read the flag: !norender may have been turned off while we were in fn.
    if hadNoRender and getgenv()._aj_norender then
        pcall(function() RunSvc:Set3dRenderingEnabled(false) end)
    end
    if not ok then warn("[AJ] prompt click failed: " .. tostring(err)) end
    return ok
end

-- Returns the button to click plus a label, or nil. A prompt whose ScreenGui
-- exists but whose button has not replicated yet still reports its label, so
-- the caller knows something is pending and no-render must stay off.
local function findPrompt()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return nil, nil end
    local ds = pg:FindFirstChild("DeviceSelect")
    if ds then
        local c    = ds:FindFirstChild("Container")
        local card = c and (c:FindFirstChild("Tablet") or c:FindFirstChild("Phone"))
        return card and card:FindFirstChild("Button"), "DeviceSelect"
    end
    local j = pg:FindFirstChild("Join")
    local f = j and j:FindFirstChild("Friends")
    if f and f.Visible == true then
        return f:FindFirstChild("Play"), "Play"
    end
    return nil, nil
end

-- Injected UI (WindUI, the no-render overlay, anything else) sits above the
-- game's own screens and eats the click, so it goes away for the duration.
local function hideInjected()
    local hidden = {}
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return hidden end
    for _, gui in ipairs(pg:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled and not GAME_GUIS[gui.Name] then
            pcall(function() gui.Enabled = false end)
            table.insert(hidden, gui)
        end
    end
    if #hidden > 0 then task.wait(0.1) end
    return hidden
end

local function restoreInjected(hidden)
    if #hidden == 0 then return end
    task.wait(0.3)
    for _, gui in ipairs(hidden) do pcall(function() gui.Enabled = true end) end
end

-- Signals are not spaced out on purpose: a task.wait between each one cost over
-- 2s per attempt at a low fps cap, and they do not need the gap.
local function fireBtn(btn)
    for _, sigName in ipairs({"MouseButton1Down", "MouseButton1Up", "MouseButton1Click", "Activated"}) do
        pcall(function()
            for _, conn in ipairs(getconnections(btn[sigName])) do pcall(conn.Function) end
        end)
        pcall(function() firesignal(btn[sigName]) end)
    end
    pcall(function() btn:Activate() end)
    -- Real input last, and only once the button has a real size — sending a
    -- click at 0,0 does nothing but can dismiss something else by accident.
    local pos, sz = btn.AbsolutePosition, btn.AbsoluteSize
    if sz.X > 0 and sz.Y > 0 then
        VIM:SendMouseButtonEvent(pos.X + sz.X/2, pos.Y + sz.Y/2, 0, true,  game, 1)
        task.wait(0.05)
        VIM:SendMouseButtonEvent(pos.X + sz.X/2, pos.Y + sz.Y/2, 0, false, game, 1)
    end
    if not IS_MOBILE then
        pcall(function()
            VIM:SendKeyEvent(true,  Enum.KeyCode.Return, false, game)
            VIM:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
        end)
    end
end

-- ── Prompt watcher ────────────────────────────────────────────────────
-- One permanent loop owns BOTH load screens. It used to be two tasks: a
-- one-shot windowed loop that was the only thing that ever handled
-- DeviceSelect, plus a 30s watcher for the Play button. If DeviceSelect
-- appeared after the window closed — routine on a slow mobile join — nothing
-- clicked it again and the bot sat on the chooser until it was restarted.
-- It never stops, so a prompt from a respawn or a rejoin is handled too.
getgenv()._aj_vimDone  = false
getgenv()._aj_promptUp = false
task.spawn(function()
    local lastPromptAt = tick()
    while alive() do
        task.wait(0.3)
        local btn, kind = findPrompt()
        if kind then
            getgenv()._aj_promptUp = true
            lastPromptAt = tick()
            if btn then
                withRender(function()
                    -- Layout is a frame or two behind when rendering resumes.
                    local t = 0
                    while btn.AbsoluteSize.X == 0 and t < 2 do task.wait(0.05); t = t + 0.05 end
                    local hidden = hideInjected()
                    fireBtn(btn)
                    restoreInjected(hidden)
                end)
                task.wait(0.8)   -- give the prompt time to actually close
            end
        else
            getgenv()._aj_promptUp = false
            -- Nothing pending and the place is up: the load sequence is over.
            -- Safe to be impatient here — unlike before, a prompt that shows up
            -- later still gets clicked by this same loop.
            if not getgenv()._aj_vimDone and game:IsLoaded() and tick() - lastPromptAt > 2 then
                getgenv()._aj_vimDone = true
                AJT.mark("prompts")
            end
        end
    end
end)

-- Bounded, NOT game.Loaded:Wait(). The Discord gateway is started at the bottom
-- of this chunk, so blocking here until the place finished loading left the bot
-- deaf for the entire join — that is where the hits that "arrived while rotating
-- servers" went. Everything downstream already waits for what it needs.
-- 12s was still far too generous. Nothing below this line actually needs the
-- place to be loaded: LocalPlayer is already resolved above, the trade arming
-- block waits on ReplicatedStorage.Trade for 180s of its own, and the gateway
-- at the tail of the chunk only needs HTTP. On an executor that injects before
-- the place finishes, this block was delaying the Discord socket AND the trade
-- listeners by the full 12s on every hop.
if not game:IsLoaded() then
    local _t0 = tick()
    while not game:IsLoaded() and tick() - _t0 < 2 do task.wait(0.1) end
end
AJT.mark("boot")

