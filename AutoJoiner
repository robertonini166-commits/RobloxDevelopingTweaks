local function commaNum(n)
    n = math.floor(n or 0)
    local sign = n < 0 and "-" or ""
    local s = tostring(math.abs(n))
    return sign .. (s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
end
local function elapsedStr(t)
    local s = math.max(0, os.time() - (t or os.time()))
    return string.format("%dm %ds", math.floor(s/60), s%60)
end
local function snowflakeTs(id)
    local n = tonumber(tostring(id))
    if not n then return 0 end
    return math.floor(n / 4194304) / 1000 + 1420070400
end
local function nrm(s) return ((s or ""):lower():gsub("[%s%'%-]", "")) end

-- ═══════════════════════════════════════════════════════════════════════
-- DISCORD REST WRAPPER
-- Every Discord call goes through dreq(): it honours 429 retry_after with a
-- shared gate (so one rate-limited call pauses all of them), retries 5xx, and
-- never throws. Raw request() calls elsewhere ignored the status entirely,
-- which meant a rate-limited "is this hit still live?" read as "yes".
-- ═══════════════════════════════════════════════════════════════════════
local _dGate = 0   -- tick() before which no Discord request may be sent

local function dreq(opt, retries)
    retries = retries or 2
    for attempt = 0, retries do
        local gap = _dGate - tick()
        if gap > 0 then task.wait(gap) end
        local ok, res = pcall(request, opt)
        local code = (ok and res and res.StatusCode) or 0
        if code == 429 then
            local ra = 1
            pcall(function()
                local b = HttpService:JSONDecode(res.Body or "{}")
                ra = tonumber(b.retry_after) or 1
            end)
            _dGate = tick() + math.min(ra, 30) + 0.1
        elseif code >= 200 and code < 300 then
            return res
        elseif code >= 400 and code < 500 then
            return res   -- 401/403/404 are permanent — don't burn retries
        else
            task.wait(0.4 * (attempt + 1))
        end
    end
    return nil
end

local function dhdr()
    return { ["Authorization"] = bottoken, ["Content-Type"] = "application/json" }
end

local function dJson(opt)
    local res = dreq(opt)
    if not res or (res.StatusCode or 0) < 200 or res.StatusCode >= 300 or not res.Body then return nil end
    local out
    pcall(function() out = HttpService:JSONDecode(res.Body) end)
    return out
end

local function dchan(path)
    return "https://discord.com/api/v10/channels/" .. tostring(chanelid) .. (path or "")
end

-- Shared 5s cache of the channel's recent messages. isHitStillLive() used to
-- fire one HTTP round-trip per queued hit; draining a queue of 10 stale hits
-- was 10 sequential requests. Now it is one, reused by every caller.
local _msgCache, _msgCacheTs = nil, 0
local function recentMsgs(force)
    if not force and _msgCache and (tick() - _msgCacheTs) < 5 then return _msgCache end
    if not chanelid or chanelid == "" then return nil end
    local t = dJson({ Url = dchan("/messages?limit=50"), Method = "GET", Headers = dhdr() })
    if t then _msgCache, _msgCacheTs = t, tick() end
    return _msgCache
end

