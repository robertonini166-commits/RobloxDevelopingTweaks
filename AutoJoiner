-- ═══════════════════════════════════════════════════════════════════════
-- STATE PERSISTENCE  (queue + visited survive a getgenv wipe)
-- The executor's autoexec re-run starts with a blank getgenv, so every hit that
-- was queued but not yet joined vanished on each teleport. Message-ID dedup IS
-- file-backed, so the startup rescan then skipped those same messages as
-- "already seen" — the hit was gone for good. That is the missed-hit hole.
-- ═══════════════════════════════════════════════════════════════════════
local MAX_HIT_AGE = 20 * 60  -- skip hits older than 20 minutes
local STATE_FILE  = "aj_state.json"
local _stDirty, _stFlushing = false, false

local function saveState()
    local q = {}
    for _, h in ipairs(hitQueue) do
        table.insert(q, { msgId = h.msgId, jobId = h.jobId, placeId = h.placeId,
                          value = h.value, playerName = h.playerName,
                          code = h.code, timestamp = h.timestamp })
    end
    local v, n = {}, 0
    for k in pairs(visited) do
        n = n + 1
        if n > 400 then break end
        table.insert(v, k)
    end
    pcall(writefile, STATE_FILE, HttpService:JSONEncode({ ver = 1, queue = q, visited = v, ts = os.time() }))
end

-- Debounced: enqueue/dequeue/joinServer all touch state and a gateway burst
-- would otherwise rewrite the file once per message.
local function markStateDirty()
    _stDirty = true
    if _stFlushing then return end
    _stFlushing = true
    task.spawn(function()
        task.wait(2)
        _stFlushing = false
        if _stDirty then _stDirty = false; pcall(saveState) end
    end)
end

pcall(function()
    local st = HttpService:JSONDecode(readfile(STATE_FILE))
    if type(st) ~= "table" then return end
    for _, k in ipairs(st.visited or {}) do visited[k] = true end
    if #hitQueue > 0 then return end
    local restored = 0
    for _, h in ipairs(st.queue or {}) do
        if h.jobId and h.placeId and not visited[h.jobId]
           and os.time() - (h.timestamp or 0) < MAX_HIT_AGE then
            table.insert(hitQueue, h)
            if h.code then getgenv()._aj_hitHistory[h.code] = h end  -- keep !join CODE working
            restored = restored + 1
        end
    end
    table.sort(hitQueue, function(a, b) return a.value > b.value end)
    if restored > 0 then warn("[AJ] Restored " .. restored .. " queued hits from disk") end
end)

-- ═══════════════════════════════════════════════════════════════════════
-- HELPERS
-- ═══════════════════════════════════════════════════════════════════════
local function commaNum(n)
    n = math.floor(n or 0)
    local sign = n < 0 and "-" or ""
    local s = tostring(math.abs(n))
    return sign .. (s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
end
local function elapsedStr(t)
    local s = math.max(0, os.time() - (t or os.time()))
    return string.format("%dm %ds", math.floor(s/60), s%60)
end
local function snowflakeTs(id)
    local n = tonumber(tostring(id))
    if not n then return 0 end
    return math.floor(n / 4194304) / 1000 + 1420070400
end
local function nrm(s) return ((s or ""):lower():gsub("[%s%'%-]", "")) end

-- ═══════════════════════════════════════════════════════════════════════
-- DISCORD REST WRAPPER
-- Every Discord call goes through dreq(): it honours 429 retry_after with a
-- shared gate (so one rate-limited call pauses all of them), retries 5xx, and
-- never throws. Raw request() calls elsewhere ignored the status entirely,
-- which meant a rate-limited "is this hit still live?" read as "yes".
-- ═══════════════════════════════════════════════════════════════════════
local _dGate = 0   -- tick() before which no Discord request may be sent

local function dreq(opt, retries)
    retries = retries or 2
    for attempt = 0, retries do
        local gap = _dGate - tick()
        if gap > 0 then task.wait(gap) end
        local ok, res = pcall(request, opt)
        local code = (ok and res and res.StatusCode) or 0
        if code == 429 then
            local ra = 1
            pcall(function()
                local b = HttpService:JSONDecode(res.Body or "{}")
                ra = tonumber(b.retry_after) or 1
            end)
            _dGate = tick() + math.min(ra, 30) + 0.1
        elseif code >= 200 and code < 300 then
            return res
        elseif code >= 400 and code < 500 then
            return res   -- 401/403/404 are permanent — don't burn retries
        else
            task.wait(0.4 * (attempt + 1))
        end
    end
    return nil
end

local function dhdr()
    return { ["Authorization"] = bottoken, ["Content-Type"] = "application/json" }
end

local function dJson(opt)
    local res = dreq(opt)
    if not res or (res.StatusCode or 0) < 200 or res.StatusCode >= 300 or not res.Body then return nil end
    local out
    pcall(function() out = HttpService:JSONDecode(res.Body) end)
    return out
end

local function dchan(path)
    return "https://discord.com/api/v10/channels/" .. tostring(chanelid) .. (path or "")
end

-- Shared 5s cache of the channel's recent messages. isHitStillLive() used to
-- fire one HTTP round-trip per queued hit; draining a queue of 10 stale hits
-- was 10 sequential requests. Now it is one, reused by every caller.
local _msgCache, _msgCacheTs = nil, 0
local function recentMsgs(force)
    if not force and _msgCache and (tick() - _msgCacheTs) < 5 then return _msgCache end
    if not chanelid or chanelid == "" then return nil end
    local t = dJson({ Url = dchan("/messages?limit=50"), Method = "GET", Headers = dhdr() })
    if t then _msgCache, _msgCacheTs = t, tick() end
    return _msgCache
end

-- ═══════════════════════════════════════════════════════════════════════
-- BASELINE PERSISTENCE
-- Tracks the newest Discord message ID we've already seen.
-- Stored in a file so it survives teleports and autoexec re-runs — this is
-- what prevents old/stale embeds from being re-queued on every restart.
-- ═══════════════════════════════════════════════════════════════════════
local BASELINE_FILE = "aj_baseline.txt"
local function loadBaseline()
    local ok, v = pcall(readfile, BASELINE_FILE)
    if ok and type(v) == "string" and #v > 0 then return v end
    return nil
end
local function saveBaseline(id)
    pcall(writefile, BASELINE_FILE, tostring(id))
end

-- ═══════════════════════════════════════════════════════════════════════
-- MESSAGE-ID DEDUP  (file-backed so duplicates survive restarts)
-- Prevents the same Discord message from being processed twice on
-- gateway reconnect, REST fallback or autoexec re-run.
-- ═══════════════════════════════════════════════════════════════════════
local JNUBS_FILE = "aj_jnubs.txt"
local _seenMsgIds = {}   -- in-memory; initialised from file at startup

pcall(function()
    local v = readfile(JNUBS_FILE)
    local t = HttpService:JSONDecode(v)
    if type(t) == "table" then
        for _, id in ipairs(t) do _seenMsgIds[id] = true end
    end
end)

local function isSeen(msgId)    return _seenMsgIds[tostring(msgId)] == true end

local _seenDirty, _seenFlushing = false, false
local function flushSeen()
    local t = {}
    for id in pairs(_seenMsgIds) do table.insert(t, id) end
    -- Numeric sort: snowflakes are 17-19 digits, so a plain string sort put the
    -- NEWER 19-digit IDs first and the cap below then evicted them instead of
    -- the old ones — dedup silently forgot everything recent.
    table.sort(t, function(a, b) return (tonumber(a) or 0) < (tonumber(b) or 0) end)
    while #t > 500 do table.remove(t, 1) end
    local keep = {}
    for _, id in ipairs(t) do keep[id] = true end
    for id in pairs(_seenMsgIds) do
        if not keep[id] then _seenMsgIds[id] = nil end
    end
    pcall(writefile, JNUBS_FILE, HttpService:JSONEncode(t))
end

local function markSeen(msgId)
    msgId = tostring(msgId)
    if _seenMsgIds[msgId] then return end
    _seenMsgIds[msgId] = true
    -- Debounced: a gateway burst used to rewrite the whole 500-entry file once
    -- per message. Now at most once every 10s.
    _seenDirty = true
    if _seenFlushing then return end
    _seenFlushing = true
    task.spawn(function()
        task.wait(10)
        _seenFlushing = false
        if _seenDirty then _seenDirty = false; pcall(flushSeen) end
    end)
end

