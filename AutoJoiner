-- ═══════════════════════════════════════════════════════════════════════
-- FPS BUDGET
-- No-render used to slam setfpscap(5) the moment it turned on. task.wait()
-- resolution is tied to the frame loop, so at 5 fps every 0.05s click step
-- became 0.2s, every 0.3s trade poll became 0.4s+, and the load screens were
-- dismissed at a crawl — that is the "inhuman" load time.
-- The cap is now driven by what the bot is doing:
--   BUSY   loading / teleporting / clicking prompts / mid-trade
--   ACTIVE sitting on a hit
--   IDLE   nothing to do — this is where the savings actually matter
-- ═══════════════════════════════════════════════════════════════════════
local FPS_BUSY, FPS_ACTIVE, FPS_IDLE = 60, 30, 10
local _fpsCur, _busyUntil = nil, 0
local function applyFps(n)
    if n == _fpsCur then return end
    _fpsCur = n
    if setfpscap then pcall(setfpscap, n) end
end
local function fpsBoost(sec)
    _busyUntil = math.max(_busyUntil, tick() + (sec or 10))
    -- Raise the cap NOW rather than waiting up to a full second for the budget
    -- loop below to notice. Everything that calls this is latency-critical (a
    -- trade request, a join), and at the 10fps idle cap that missed second was
    -- landing directly on the trade path.
    applyFps(FPS_BUSY)
end
fpsBoost(40)   -- full speed for the whole join + load-screen sequence (set before
               -- the loop starts: task.spawn runs its first tick synchronously)
task.spawn(function()
    while alive() do
        if not getgenv()._aj_norender or tick() < _busyUntil then applyFps(FPS_BUSY)
        elseif getgenv()._aj_currentHit                      then applyFps(FPS_ACTIVE)
        else                                                      applyFps(FPS_IDLE) end
        task.wait(1)
    end
end)

-- ═══════════════════════════════════════════════════════════════════════
-- LOAD TIMING
-- The "30s from hit to trade" figure is two costs stacked, and they have
-- completely different fixes: the engine teleport + place load (nothing in
-- Lua shortens that) and this script's own boot. Stamping the wall clock on
-- both sides of the hop is the only way to know which one to attack.
-- `aj_tp.txt` is written right before TeleportToPlaceInstance and read back
-- by the next generation, so `gap` is the pure engine cost in seconds.
-- Everything is bundled in one table on purpose — this chunk is already deep
-- into Luau's 200-local budget.
-- ═══════════════════════════════════════════════════════════════════════
local AJT = { t0 = tick(), gap = nil, ph = {} }
function AJT.mark(name)
    AJT.ph[#AJT.ph + 1] = string.format("%s %.1fs", name, tick() - AJT.t0)
end
function AJT.report(name)
    AJT.mark(name)
    local line = "⏱ load: " .. (AJT.gap and (AJT.gap .. "s engine + ") or "")
                 .. table.concat(AJT.ph, " → ")
    warn("[AJ] " .. line)
    dbg(line)
end
pcall(function()
    local sent = tonumber(readfile("aj_tp.txt"))
    if sent then
        local gap = os.time() - sent
        -- Ignore a stale stamp from a generation that died without teleporting.
        if gap >= 0 and gap < 300 then AJT.gap = gap end
    end
end)
pcall(writefile, "aj_tp.txt", "")

