-- TEMA
-- ============================================================================
-- Negro de verdad: el fondo es 0,0,0. Las filas suben apenas 9 puntos para
-- separarse sin dejar de leerse como negro.
ToolUI.Theme = {
    bg      = Color3.fromRGB(0, 0, 0),
    row     = Color3.fromRGB(9, 9, 9),
    line    = Color3.fromRGB(26, 26, 26),
    edge    = Color3.fromRGB(34, 34, 34),
    text    = Color3.fromRGB(240, 240, 242),
    dim     = Color3.fromRGB(112, 112, 118),
    accent  = Color3.fromRGB(48, 220, 120),
    green   = Color3.fromRGB(48, 220, 120),
    amber   = Color3.fromRGB(255, 176, 60),
    red     = Color3.fromRGB(255, 72, 72),
    blue    = Color3.fromRGB(90, 190, 255),
    btnBg   = Color3.fromRGB(16, 16, 16),
    btnHi   = Color3.fromRGB(30, 30, 30),
    white   = Color3.fromRGB(255, 255, 255),
}

-- Transparencia justita: se intuye el juego detras pero el texto no pierde
-- contraste. Por encima de 0.12 el verde sobre hierba ya cuesta de leer.
ToolUI.PanelAlpha = 0.08
ToolUI.RowAlpha   = 0.06

ToolUI.Silent = false
function ToolUI:SetSilent(v) self.Silent = v and true or false end

-- ============================================================================
-- AYUDAS
-- ============================================================================
local T = ToolUI.Theme

local function host()
    return (gethui and gethui()) or game:GetService("CoreGui")
end

local function corner(inst, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 10)
    c.Parent = inst
    return c
end

local function stroke(inst, col, th, trans)
    local s = Instance.new("UIStroke")
    s.Color = col or T.edge
    s.Thickness = th or 1
    s.Transparency = trans or 0
    s.Parent = inst
    return s
end

local function tween(inst, time, props, style, dir)
    local ti = TweenInfo.new(time,
        style or Enum.EasingStyle.Quint,
        dir or Enum.EasingDirection.Out)
    local tw = TweenService:Create(inst, ti, props)
    tw:Play()
    return tw
end

-- Destello que cruza en diagonal al pasar por encima. Se anima el Offset del
-- gradiente, no la posicion de la capa, asi que no toca el layout de nada.
local function addGlint(inst, rot)
    inst.ClipsDescendants = true

    local sheen = Instance.new("Frame")
    sheen.Name = "Glint"
    sheen.BackgroundColor3 = T.white
    sheen.BackgroundTransparency = 0
    sheen.BorderSizePixel = 0
    sheen.Size = UDim2.fromScale(1, 1)
    sheen.ZIndex = 20
    sheen.Parent = inst

    local g = Instance.new("UIGradient")
    g.Rotation = rot or 22
    g.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0.00, 1),
        NumberSequenceKeypoint.new(0.42, 1),
        NumberSequenceKeypoint.new(0.50, 0.80),
        NumberSequenceKeypoint.new(0.58, 1),
        NumberSequenceKeypoint.new(1.00, 1),
    })
    g.Offset = Vector2.new(-1.3, 0)
    g.Parent = sheen

    local playing = false
    inst.MouseEnter:Connect(function()
        if playing then return end
        playing = true
        g.Offset = Vector2.new(-1.3, 0)
        local tw = tween(g, 0.55, { Offset = Vector2.new(1.3, 0) }, Enum.EasingStyle.Quad)
        tw.Completed:Connect(function() playing = false end)
    end)
    return sheen
end
ToolUI.addGlint = addGlint

-- Entrada escalonada de una fila. Se apunta el valor final de cada pieza ANTES
-- de ponerla invisible, porque las filas no son todas iguales.
local function animateIn(row, idx)
    local delay = math.min(idx * 0.025, 0.3)

    local sc = Instance.new("UIScale")
    sc.Scale = 0.92
    sc.Parent = row

    local fades = {}
    local parts = row:GetDescendants()
    table.insert(parts, 1, row)
    for _, d in ipairs(parts) do
        local isGlint = d.Name == "Glint" or (d.Parent and d.Parent.Name == "Glint")
        if not isGlint then
            if d:IsA("TextLabel") or d:IsA("TextButton") then
                fades[#fades + 1] = { obj = d, prop = "TextTransparency",
                                      to = d.TextTransparency }
                d.TextTransparency = 1
            end
            if d:IsA("GuiObject") and d.BackgroundTransparency < 1 then
                fades[#fades + 1] = { obj = d, prop = "BackgroundTransparency",
                                      to = d.BackgroundTransparency }
                d.BackgroundTransparency = 1
            end
            if d:IsA("UIStroke") then
                fades[#fades + 1] = { obj = d, prop = "Transparency", to = d.Transparency }
                d.Transparency = 1
            end
        end
    end

    task.delay(delay, function()
        if not row.Parent then return end
        tween(sc, 0.34, { Scale = 1 })
        for _, f in ipairs(fades) do
            if f.obj.Parent then tween(f.obj, 0.34, { [f.prop] = f.to }) end
        end
    end)
end

-- ============================================================================
-- AVISOS
-- ============================================================================
-- Pila arriba a la derecha, el nuevo entra por arriba. Cada aviso es una tarjeta
-- negra con barra de color a la izquierda y una barrita de tiempo que se vacia.
--
-- ⚠️ CADA AVISO VA DENTRO DE UN ENVOLTORIO. El hijo del UIListLayout es el
-- envoltorio; la tarjeta se desliza DENTRO de el. Animar la tarjeta directamente
-- no sirve porque el layout le reescribe la Position cada frame y el tween no se
-- ve. Y al cerrarse se encoge la ALTURA del envoltorio, que el layout si respeta:
-- asi los de abajo suben acompañando en vez de dar un salto seco.

local NOTIF_W = 300
local KINDS = {
    info    = { color = T.blue,  glyph = "•" },
    success = { color = T.green, glyph = "✓" },
    warn    = { color = T.amber, glyph = "!"      },
    error   = { color = T.red,   glyph = "✕" },
}

local Notif = { gui = nil, holder = nil, live = {} }

local function notifRoot()
    if Notif.gui and Notif.gui.Parent then return Notif.holder end

    local gui = Instance.new("ScreenGui")
    gui.Name = "ToolUI_Notify"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 10000
    gui.AutoLocalize = false
    gui.Parent = host()

    local holder = Instance.new("Frame")
    holder.Name = "Holder"
    holder.AnchorPoint = Vector2.new(1, 0)
    holder.Position = UDim2.new(1, -18, 0, 18)
    holder.Size = UDim2.fromOffset(NOTIF_W, 0)
    holder.AutomaticSize = Enum.AutomaticSize.Y
    holder.BackgroundTransparency = 1
    holder.Parent = gui

    local list = Instance.new("UIListLayout")
    list.Padding = UDim.new(0, 8)
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.HorizontalAlignment = Enum.HorizontalAlignment.Right
    list.Parent = holder

    Notif.gui, Notif.holder = gui, holder
    return holder
end

local notifOrder = 0

--  ToolUI:Notify{ Title=, Text=, Kind="info"/"success"/"warn"/"error",
--                 Duration=4, OnClick=fn }
--  Devuelve un mando con :Close() y :Set(title, text) para ir actualizandolo.
function ToolUI:Notify(o)
    if type(o) == "string" then o = { Title = o } end
    o = o or {}
    if self.Silent then
        return { Close = function() end, Set = function() end }
    end

    local kind = KINDS[o.Kind or "info"] or KINDS.info
    local dur  = o.Duration or 4
    local body = o.Text or o.Content
    local holder = notifRoot()

    notifOrder = notifOrder + 1
    local H = body and 64 or 46

    -- El envoltorio es el hijo del layout; no se toca su posicion, solo su alto.
    local wrap = Instance.new("Frame")
    wrap.Name = "Wrap"
    wrap.BackgroundTransparency = 1
    wrap.Size = UDim2.new(0, NOTIF_W, 0, H)
    wrap.LayoutOrder = -notifOrder     -- negativo: el mas nuevo queda arriba
    wrap.Parent = holder

    local card = Instance.new("TextButton")
    card.Name = "Card"
    card.AutoButtonColor = false
    card.Text = ""
    card.Size = UDim2.fromScale(1, 1)
    card.BackgroundColor3 = T.bg
    card.BackgroundTransparency = 0.06
    card.BorderSizePixel = 0
    card.Parent = wrap
    corner(card, 12)
    local edge = stroke(card, kind.color, 1.5, 0.45)
    addGlint(card, 18)

    -- Barra de color pegada al borde izquierdo: identifica el tipo de un vistazo,
    -- que es lo unico que se mira cuando saltan tres seguidos.
    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 3, 1, -16)
    bar.Position = UDim2.new(0, 8, 0, 8)
    bar.BackgroundColor3 = kind.color
    bar.BorderSizePixel = 0
    bar.ZIndex = 2
    bar.Parent = card
    corner(bar, 2)

    local ico = Instance.new("TextLabel")
    ico.Size = UDim2.fromOffset(20, 20)
    ico.Position = UDim2.new(0, 18, 0, 11)
    ico.BackgroundTransparency = 1
    ico.Font = Enum.Font.GothamBold
    ico.TextSize = 15
    ico.TextColor3 = kind.color
    ico.Text = kind.glyph
    ico.ZIndex = 2
    ico.Parent = card

    local title = Instance.new("TextLabel")
    title.Name = "Title"
    title.Position = UDim2.new(0, 42, 0, 11)
    title.Size = UDim2.new(1, -56, 0, 18)
    title.BackgroundTransparency = 1
    title.Font = Enum.Font.GothamBold
    title.TextSize = 13
    title.TextColor3 = T.text
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.TextTruncate = Enum.TextTruncate.AtEnd
    title.Text = o.Title or "Notice"
    title.ZIndex = 2
    title.Parent = card

    local sub
    if body then
        sub = Instance.new("TextLabel")
        sub.Name = "Body"
        sub.Position = UDim2.new(0, 42, 0, 29)
        sub.Size = UDim2.new(1, -56, 0, 26)
        sub.BackgroundTransparency = 1
        sub.Font = Enum.Font.GothamMedium
        sub.TextSize = 12
        sub.TextColor3 = T.dim
        sub.TextXAlignment = Enum.TextXAlignment.Left
        sub.TextYAlignment = Enum.TextYAlignment.Top
        sub.TextWrapped = true
        sub.Text = body
        sub.ZIndex = 2
        sub.Parent = card
    end

    -- Barrita de tiempo: sin ella no se sabe si al aviso le queda un segundo o
    -- cinco, y da la sensacion de que se van solos cuando les apetece.
    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -16, 0, 2)
    track.Position = UDim2.new(0, 8, 1, -6)
    track.BackgroundColor3 = T.line
    track.BorderSizePixel = 0
    track.ZIndex = 2
    track.Parent = card
    corner(track, 1)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(1, 1)
    fill.BackgroundColor3 = kind.color
    fill.BorderSizePixel = 0
    fill.ZIndex = 3
    fill.Parent = track
    corner(fill, 1)

    -- ---- entrada: la tarjeta entra deslizando DENTRO del envoltorio ----------
    card.Position = UDim2.new(1, 12, 0, 0)
    card.BackgroundTransparency = 1
    edge.Transparency = 1
    title.TextTransparency = 1
    ico.TextTransparency = 1
    bar.BackgroundTransparency = 1
    if sub then sub.TextTransparency = 1 end

    tween(card, 0.34, { Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 0.06 })
    tween(edge, 0.34, { Transparency = 0.45 })
    tween(title, 0.34, { TextTransparency = 0 })
    tween(ico, 0.34, { TextTransparency = 0 })
    tween(bar, 0.34, { BackgroundTransparency = 0 })
    if sub then tween(sub, 0.34, { TextTransparency = 0 }) end

    tween(fill, dur, { Size = UDim2.fromScale(0, 1) }, Enum.EasingStyle.Linear)

    local closed = false
    local handle = {}

    function handle:Close()
        if closed then return end
        closed = true
        Notif.live[handle] = nil
        tween(card, 0.22, { Position = UDim2.new(1, 12, 0, 0), BackgroundTransparency = 1 })
        tween(edge, 0.22, { Transparency = 1 })
        tween(title, 0.22, { TextTransparency = 1 })
        tween(ico, 0.22, { TextTransparency = 1 })
        if sub then tween(sub, 0.22, { TextTransparency = 1 }) end
        -- Encoger el ENVOLTORIO es lo que hace que los de abajo suban suave.
        task.delay(0.12, function()
            if not wrap.Parent then return end
            tween(wrap, 0.2, { Size = UDim2.new(0, NOTIF_W, 0, 0) })
            task.delay(0.24, function()
                if wrap.Parent then wrap:Destroy() end
            end)
        end)
    end

    function handle:Set(newTitle, newBody)
        if closed then return end
        if newTitle then title.Text = newTitle end
        if newBody and sub then sub.Text = newBody end
    end

    card.MouseButton1Click:Connect(function()
        if o.OnClick then task.spawn(o.OnClick) end
        handle:Close()
    end)

    Notif.live[handle] = true
    task.delay(dur, function() handle:Close() end)
    return handle
end

function ToolUI:ClearNotifications()
    for h in pairs(Notif.live) do pcall(function() h:Close() end) end
end

-- ============================================================================
-- VENTANA
-- ============================================================================
local Window = {}
Window.__index = Window

--  ToolUI:Window{ Title=, Subtitle=, Logo=assetId, Discord=url,
--                 Width=, Height=, HideKey=Enum.KeyCode.RightShift,
--                 Anchor="left"/"right" }
function ToolUI:Window(o)
    o = o or {}
    local self = setmetatable({}, Window)

    -- ⚠️ EL TAMAÑO SALE DEL VIEWPORT, NO ES UN NUMERO FIJO. Un panel clavado en
    -- pixeles se sale de la pantalla en movil. Se pide un cuarto del ancho y dos
    -- tercios del alto, con topes por los dos lados: grande en PC, entero en el
    -- telefono.
    local VP = (workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize)
            or Vector2.new(1280, 720)
    local PW = o.Width  or math.clamp(math.floor(VP.X * 0.24), 300, 380)
    local PH = o.Height or math.clamp(math.floor(VP.Y * 0.66), 380, 560)
    local HEAD_H = 60

    self.W, self.H, self.HeadH = PW, PH, HEAD_H
    self.rows, self.order = {}, 0
    self.built = false

    local gui = Instance.new("ScreenGui")
    gui.Name = o.Name or "ToolUI"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 9999
    -- Sin esto Roblox traduce los rotulos que tiene en su tabla y deja el resto
    -- en ingles: medio panel en cada idioma.
    gui.AutoLocalize = false
    gui.Parent = host()
    self.Gui = gui

    local Panel = Instance.new("Frame")
    Panel.Name = "Panel"
    Panel.AnchorPoint = Vector2.new(0, 0.5)
    if o.Anchor == "right" then
        Panel.AnchorPoint = Vector2.new(1, 0.5)
        Panel.Position = UDim2.new(1, -26, 0.5, 0)
    else
        Panel.Position = UDim2.new(0, 26, 0.5, 0)
    end
    Panel.Size = UDim2.fromOffset(PW, PH)
    Panel.BackgroundColor3 = T.bg
    Panel.BackgroundTransparency = ToolUI.PanelAlpha
    Panel.BorderSizePixel = 0
    Panel.Parent = gui
    corner(Panel, 18)
    local panelEdge = stroke(Panel, T.edge, 1.5)
    self.Panel, self.PanelEdge = Panel, panelEdge

    -- Halo detras del panel. Tres capas cada vez mas grandes y transparentes
    -- imitan una sombra difusa sin necesitar imagen de sombra.
    local Glow = {}
    for i = 1, 3 do
        local g = Instance.new("Frame")
        g.Name = "Glow" .. i
        g.AnchorPoint = Vector2.new(0.5, 0.5)
        g.Position = UDim2.fromScale(0.5, 0.5)
        g.Size = UDim2.new(1, i * 10, 1, i * 10)
        g.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        g.BackgroundTransparency = 0.55 + i * 0.13
        g.BorderSizePixel = 0
        g.ZIndex = -i
        corner(g, 22 + i * 2)
        g.Parent = Panel
        Glow[i] = g
    end
    self.Glow = Glow

    -- Escala propia para la entrada: tocar UIScale no descoloca nada, mientras
    -- que animar Size obliga a recalcular el layout entero en cada frame.
    local PanelScale = Instance.new("UIScale")
    PanelScale.Scale = 0.9
    PanelScale.Parent = Panel
    self.Scale = PanelScale

    -- ---- cabecera ----------------------------------------------------------
    local Head = Instance.new("Frame")
    Head.Name = "Head"
    Head.Size = UDim2.new(1, 0, 0, HEAD_H)
    Head.BackgroundTransparency = 1
    Head.Parent = Panel
    self.Head = Head

    local headTint = Instance.new("Frame")
    headTint.Size = UDim2.fromScale(1, 1)
    headTint.BackgroundColor3 = T.accent
    headTint.BackgroundTransparency = 0.94
    headTint.BorderSizePixel = 0
    headTint.ZIndex = 0
    headTint.Parent = Head
    corner(headTint, 18)
    local tintGrad = Instance.new("UIGradient")
    tintGrad.Rotation = 90
    tintGrad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(1, 1),
    })
    tintGrad.Parent = headTint

    local headLine = Instance.new("Frame")
    headLine.Size = UDim2.new(1, -28, 0, 1)
    headLine.Position = UDim2.new(0, 14, 1, -1)
    headLine.BackgroundColor3 = T.line
    headLine.BorderSizePixel = 0
    headLine.ZIndex = 2
    headLine.Parent = Head
    local hlGrad = Instance.new("UIGradient")
    hlGrad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.2, 0),
        NumberSequenceKeypoint.new(0.8, 0),
        NumberSequenceKeypoint.new(1, 1),
    })
    hlGrad.Parent = headLine

    local ICON = 38
    local Dot = Instance.new("ImageLabel")
    Dot.Size = UDim2.fromOffset(ICON, ICON)
    Dot.Position = UDim2.new(0, 14, 0, (HEAD_H - ICON) / 2)
    Dot.BackgroundColor3 = T.row
    Dot.BackgroundTransparency = o.Logo and 1 or 0
    Dot.BorderSizePixel = 0
    Dot.Image = o.Logo or ""
    Dot.ScaleType = Enum.ScaleType.Fit
    Dot.ZIndex = 2
    Dot.Parent = Head
    corner(Dot, ICON / 2)
    if not o.Logo then
        stroke(Dot, T.accent, 1.5, 0.5)
        local ini = Instance.new("TextLabel")
        ini.Size = UDim2.fromScale(1, 1)
        ini.BackgroundTransparency = 1
        ini.Text = o.Initials or string.sub(o.Title or "UI", 1, 2):upper()
        ini.TextSize = 14
        ini.Font = Enum.Font.GothamBold
        ini.TextColor3 = T.accent
        ini.ZIndex = 3
        ini.Parent = Dot
    end
    self.Logo = Dot

    -- Punto de estado pegado al logo: verde vivo cuando algo corre, apagado en
    -- reposo. Es lo primero que se mira para saber si el hub esta trabajando.
    local Live = Instance.new("Frame")
    Live.Size = UDim2.fromOffset(10, 10)
    Live.Position = UDim2.new(0, 14 + ICON - 9, 0, (HEAD_H - ICON) / 2 + ICON - 9)
    Live.BackgroundColor3 = T.dim
    Live.BorderSizePixel = 0
    Live.ZIndex = 4
    Live.Parent = Head
    corner(Live, 5)
    stroke(Live, T.bg, 2)
    self.Live = Live

    local HB = 32
    local nBtns = o.Discord and 2 or 1
    local TITLE_X = 14 + ICON + 12
    local rightPad = HB * nBtns + 6 * (nBtns - 1) + 14 + 8

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, -TITLE_X - rightPad, 0, 20)
    Title.Position = UDim2.new(0, TITLE_X, 0, 12)
    Title.BackgroundTransparency = 1
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 17
    Title.TextColor3 = T.text
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.TextTruncate = Enum.TextTruncate.AtEnd
    Title.Text = o.Title or "TOOL UI"
    Title.ZIndex = 2
    Title.Parent = Head
    self.Title = Title
    self.BaseTitle = Title.Text

    local Sub = Instance.new("TextLabel")
    Sub.Size = UDim2.new(1, -TITLE_X - rightPad, 0, 15)
    Sub.Position = UDim2.new(0, TITLE_X, 0, 32)
    Sub.BackgroundTransparency = 1
    Sub.Font = Enum.Font.GothamMedium
    Sub.TextSize = 11
    Sub.TextColor3 = T.dim
    Sub.TextXAlignment = Enum.TextXAlignment.Left
    Sub.TextTruncate = Enum.TextTruncate.AtEnd
    Sub.Text = o.Subtitle or ""
    Sub.ZIndex = 2
    Sub.Parent = Head
    self.Sub = Sub

    local slot = 0
    local function headButton(txt, cb, bg, img)
        local b = Instance.new("ImageButton")
        b.Size = UDim2.fromOffset(HB, HB)
        b.Position = UDim2.new(1, -(HB + 14 + slot * (HB + 6)), 0, (HEAD_H - HB) / 2)
        b.BackgroundColor3 = bg or T.row
        b.BackgroundTransparency = img and 1 or 0
        b.BorderSizePixel = 0
        b.Image = img or ""
        b.ScaleType = Enum.ScaleType.Fit
        b.AutoButtonColor = false
        b.ZIndex = 2
        b.Parent = Head
        corner(b, HB / 2)
        if not img then
            local l = Instance.new("TextLabel")
            l.Size = UDim2.fromScale(1, 1)
            l.BackgroundTransparency = 1
            l.Text = txt
            l.TextSize = 15
            l.Font = Enum.Font.GothamBold
            l.TextColor3 = T.dim
            l.ZIndex = 3
            l.Parent = b
            b:SetAttribute("HasLabel", true)
        end
        b.MouseButton1Click:Connect(cb)
        slot = slot + 1
        return b
    end

    local Fold = headButton("-", function() self:Fold() end)
    self.FoldBtn = Fold

    if o.Discord then
        headButton("DC", function()
            local set = setclipboard or toclipboard
            if set then
                set(o.Discord)
                ToolUI:Notify({ Title = "Discord",
                                Text = "Link copied to clipboard",
                                Kind = "success", Duration = 4 })
