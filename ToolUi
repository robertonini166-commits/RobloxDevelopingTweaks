    b.AutoButtonColor = false
    b.LayoutOrder = self:_next()
    b.Parent = self.Body
    corner(b, 11)
    stroke(b, T.line, 1, 0.3)
    addGlint(b)

    local bs = Instance.new("UIScale")
    bs.Parent = b

    b.MouseEnter:Connect(function() tween(b, 0.12, { BackgroundColor3 = T.btnHi }) end)
    b.MouseLeave:Connect(function() tween(b, 0.12, { BackgroundColor3 = T.btnBg }) end)
    b.MouseButton1Click:Connect(function()
        -- Hundir y soltar: en tactil no hay hover, sin esto no hay forma de saber
        -- si el toque ha entrado.
        tween(bs, 0.07, { Scale = 0.97 }, Enum.EasingStyle.Quad)
        task.delay(0.07, function() tween(bs, 0.16, { Scale = 1 }, Enum.EasingStyle.Back) end)
        if cb then task.spawn(cb) end
    end)

    return { Instance = b, SetText = function(_, t) b.Text = t end }
end

-- ============================================================================
-- COMPORTAMIENTO DE LA VENTANA
-- ============================================================================
-- El halo cuelga del propio Panel y va a Scale 1,1 con offset, asi que se pliega
-- y se arrastra solo. Una version anterior tenia una sombra suelta que habia que
-- mover a mano y se descolgaba en cuanto las dos animaciones se solapaban.
function Window:Fold(force)
    local want = (force == nil) and (not self.folded) or (force and true or false)
    if want == self.folded then return end
    self.folded = want

    local lbl = self.FoldBtn:FindFirstChildWhichIsA("TextLabel")
    if lbl then lbl.Text = want and "+" or "-" end

    if want then
        self.Body.Visible = false
        tween(self.Panel, 0.26, { Size = UDim2.fromOffset(self.W, self.HeadH) })
    else
        tween(self.Panel, 0.26, { Size = UDim2.fromOffset(self.W, self.H) })
        -- Enseñar el cuerpo cuando el panel ya tiene sitio: si no, se ve la lista
        -- recortada durante el crecimiento.
        task.delay(0.1, function() self.Body.Visible = true end)
    end
end

function Window:_wireDrag()
    local dragging, startPos, startMouse
    self.Head.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startPos = self.Panel.Position
            startMouse = input.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local d = input.Position - startMouse
            self.Panel.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

function Window:_wireHideKey(key)
    if key == false then return end
    key = key or Enum.KeyCode.RightShift
    UIS.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == key then self.Gui.Enabled = not self.Gui.Enabled end
    end)
end

function Window:Show()  self.Gui.Enabled = true  end
function Window:Hide()  self.Gui.Enabled = false end
function Window:ToggleVisible() self.Gui.Enabled = not self.Gui.Enabled end

function Window:SetTitle(text, col)
    self.Title.Text = text
    if col then self.Title.TextColor3 = col end
end

function Window:SetSubtitle(text) self.Sub.Text = text end

-- Punto de estado. `Pulse(true)` lo pone a latir en verde; `Pulse(false)` lo deja
-- fijo y apagado. El latido solo se recalcula mientras esta encendido, para no
-- tener un bucle corriendo sin motivo.
function Window:Pulse(on, col)
    self._pulse = on and true or false
    self._pulseCol = col or T.accent
    if self._pulseThread then return end
    self._pulseThread = task.spawn(function()
        local t = 0
        while self.Gui and self.Gui.Parent do
            task.wait(0.08)
            if self._pulse then
                t = t + 0.08
                local k = 0.5 + 0.5 * math.sin(t * 4)
                self.Live.BackgroundColor3 = self._pulseCol:Lerp(T.bg, k * 0.55)
            else
                self.Live.BackgroundColor3 = T.dim
            end
        end
        self._pulseThread = nil
    end)
end

function Window:SetDot(col)
    self._pulse = false
    self.Live.BackgroundColor3 = col
end

-- Entrada: el panel se desliza desde su lado creciendo de 0.9 a 1. El Quint/Out
-- frena muy tarde, o sea que parece que tiene peso en vez del arranque plano de
-- un lineal. Las filas entran detras, escalonadas.
function Window:Build()
    if self.built then return self end
    self.built = true

    local restPos = self.Panel.Position
    local dx = (self.Panel.AnchorPoint.X == 1) and 60 or -60
    self.Panel.Position = UDim2.new(restPos.X.Scale, restPos.X.Offset + dx,
                                    restPos.Y.Scale, restPos.Y.Offset)
    self.Panel.BackgroundTransparency = 1
    self.PanelEdge.Transparency = 1
    for _, g in ipairs(self.Glow) do g.BackgroundTransparency = 1 end

    tween(self.Panel, 0.42, { Position = restPos,
                              BackgroundTransparency = ToolUI.PanelAlpha })
    tween(self.Scale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
    tween(self.PanelEdge, 0.42, { Transparency = 0 })
    for i, g in ipairs(self.Glow) do
        tween(g, 0.42, { BackgroundTransparency = 0.55 + i * 0.13 })
    end

    local idx = 0
    for _, c in ipairs(self.Body:GetChildren()) do
        if not c:IsA("UIListLayout") then
            idx = idx + 1
            animateIn(c, idx)
        end
    end
    return self
end

function Window:Destroy()
    self._pulse = false
    if self.Gui then self.Gui:Destroy() end
end

-- Limpia paneles y avisos que hayan quedado de una ejecucion anterior. Sin esto,
-- reejecutar el script deja la ventana vieja flotando encima de la nueva y parece
-- que hay dos hubs cargados.
function ToolUI:Cleanup(names)
    names = names or { "ToolUI", "ToolUI_Notify" }
    local h = host()
    for _, g in ipairs(h:GetChildren()) do
        for _, n in ipairs(names) do
            if g.Name == n then pcall(function() g:Destroy() end) end
        end
    end
    Notif.gui, Notif.holder, Notif.live = nil, nil, {}
end

return ToolUI
