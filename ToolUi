                                Kind = "info", Duration = 10 })
            end
        end, o.DiscordColor or Color3.fromRGB(88, 101, 242), o.DiscordIcon)
    end

    -- ---- cuerpo ------------------------------------------------------------
    local Body = Instance.new("ScrollingFrame")
    Body.Name = "Body"
    Body.Position = UDim2.new(0, 14, 0, HEAD_H + 6)
    Body.Size = UDim2.new(1, -28, 1, -(HEAD_H + 20))
    Body.BackgroundTransparency = 1
    Body.BorderSizePixel = 0
    Body.ScrollBarThickness = 4
    Body.ScrollBarImageColor3 = T.edge
    Body.ScrollBarImageTransparency = 0.3
    Body.CanvasSize = UDim2.new()
    Body.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Body.ClipsDescendants = true
    Body.Parent = Panel
    self.Body = Body

    local List = Instance.new("UIListLayout")
    List.Padding = UDim.new(0, 8)
    List.SortOrder = Enum.SortOrder.LayoutOrder
    List.Parent = Body

    self:_wireDrag()
    self:_wireHideKey(o.HideKey)
    return self
end

function Window:_next()
    self.order = self.order + 1
    return self.order
end

