function Window:Toggle(label, default, cb)
    local f = self:Row(46)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -86, 1, 0)
    l.Position = UDim2.new(0, 14, 0, 0)
    l.BackgroundTransparency = 1
    l.Font = Enum.Font.GothamMedium
    l.TextSize = 13
    l.TextColor3 = T.text
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextTruncate = Enum.TextTruncate.AtEnd
    l.Text = label
    l.Parent = f

    local SW_W, SW_H, KN = 50, 26, 20
    local swOff = Color3.fromRGB(34, 34, 34)
    local sw = Instance.new("TextButton")
    sw.Size = UDim2.fromOffset(SW_W, SW_H)
    sw.Position = UDim2.new(1, -(SW_W + 14), 0.5, -SW_H / 2)
    sw.BackgroundColor3 = default and T.accent or swOff
    sw.BorderSizePixel = 0
    sw.Text = ""
    sw.AutoButtonColor = false
    sw.Parent = f
    corner(sw, SW_H / 2)

    local onPos  = UDim2.new(1, -(KN + 3), 0.5, -KN / 2)
    local offPos = UDim2.new(0, 3, 0.5, -KN / 2)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(KN, KN)
    knob.Position = default and onPos or offPos
    knob.BackgroundColor3 = T.white
    knob.BorderSizePixel = 0
    knob.Parent = sw
    corner(knob, KN / 2)

    local on = default and true or false
    local function apply(v, fire)
        on = v and true or false
        -- Back/Out da el rebotito al final del recorrido: se nota mucho y cuesta
        -- lo mismo que un lineal.
        tween(sw, 0.2, { BackgroundColor3 = on and T.accent or swOff }, Enum.EasingStyle.Quad)
        tween(knob, 0.2, { Position = on and onPos or offPos }, Enum.EasingStyle.Back)
        if fire and cb then cb(on) end
    end
    sw.MouseButton1Click:Connect(function() apply(not on, true) end)

    return {
        Frame = f,
        Set = function(_, v) apply(v, false) end,
        Get = function() return on end,
    }
end

-- ⚠️ LAS TRES PIEZAS SE COLOCAN DESDE EL BORDE DERECHO Y NO SE PUEDEN SOLAPAR.
-- Una version anterior ponia el numero a -88 y el boton "-" a -76: el boton se
-- dibujaba encima y el valor no se veia nunca. Aqui se encadenan anchos y huecos
-- desde la derecha: [-] [valor] [+].
function Window:Stepper(label, value, min, max, stepv, fmt, cb)
    local f = self:Row(46)
    local BW, VW, PAD, GAP = 28, 40, 14, 4
    local xPlus  = PAD + BW
    local xVal   = xPlus + GAP + VW
    local xMinus = xVal + GAP + BW

    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -(xMinus + 14), 1, 0)
    l.Position = UDim2.new(0, 14, 0, 0)
    l.BackgroundTransparency = 1
    l.Font = Enum.Font.GothamMedium
    l.TextSize = 13
    l.TextColor3 = T.text
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextTruncate = Enum.TextTruncate.AtEnd
    l.Text = label
    l.Parent = f

    local val = Instance.new("TextLabel")
    val.Size = UDim2.fromOffset(VW, 24)
    val.Position = UDim2.new(1, -xVal, 0.5, -12)
    val.BackgroundTransparency = 1
    val.Font = Enum.Font.GothamBold
    val.TextSize = 15
    val.TextColor3 = T.green
    val.ZIndex = 2
    val.Parent = f

    local cur = value
    local function paint() val.Text = (fmt and fmt(cur)) or tostring(cur) end
    paint()

    local function mk(txt, dx, off)
        local b = Instance.new("TextButton")
        b.Size = UDim2.fromOffset(BW, BW)
        b.Position = UDim2.new(1, off, 0.5, -BW / 2)
        b.BackgroundColor3 = T.btnBg
        b.BorderSizePixel = 0
        b.Font = Enum.Font.GothamBold
        b.TextSize = 17
        b.TextColor3 = T.text
        b.Text = txt
        b.AutoButtonColor = false
        b.Parent = f
        corner(b, BW / 2)
        stroke(b, T.line, 1, 0.3)
        b.MouseButton1Click:Connect(function()
            cur = math.clamp(cur + dx, min, max)
            paint()
            -- Latido corto del numero para que se vea que respondio.
            val.TextColor3 = T.white
            tween(val, 0.25, { TextColor3 = T.green })
            if cb then cb(cur) end
        end)
        b.MouseEnter:Connect(function()
            tween(b, 0.1, { BackgroundColor3 = T.btnHi })
        end)
        b.MouseLeave:Connect(function()
            tween(b, 0.1, { BackgroundColor3 = T.btnBg })
        end)
    end
    mk("-", -stepv, -xMinus)
    mk("+",  stepv, -xPlus)

    return {
        Frame = f,
        Set = function(_, v) cur = math.clamp(v, min, max) paint() end,
        Get = function() return cur end,
    }
end

--  colorFn(v) -> texto, color   (opcional; para avisar por tramos)
function Window:Slider(label, value, min, max, stepv, fmt, cb, colorFn)
    local f = self:Row(64)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(0.5, -10, 0, 20)
    l.Position = UDim2.new(0, 14, 0, 8)
    l.BackgroundTransparency = 1
    l.Font = Enum.Font.GothamMedium
    l.TextSize = 13
    l.TextColor3 = T.text
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextTruncate = Enum.TextTruncate.AtEnd
    l.Text = label
    l.Parent = f

    local val = Instance.new("TextLabel")
    val.Size = UDim2.new(0.5, -14, 0, 20)
    val.Position = UDim2.new(0.5, 0, 0, 8)
    val.BackgroundTransparency = 1
    val.Font = Enum.Font.GothamBold
    val.TextSize = 13
    val.TextColor3 = T.green
    val.TextXAlignment = Enum.TextXAlignment.Right
    val.Parent = f

    local trackH = 8
    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -28, 0, trackH)
    track.Position = UDim2.new(0, 14, 0, 38)
    track.BackgroundColor3 = T.line
    track.BorderSizePixel = 0
    track.Parent = f
    corner(track, trackH / 2)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = T.accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    corner(fill, trackH / 2)

    local KS = 18
    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(KS, KS)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(0, 0, 0.5, 0)
    knob.BackgroundColor3 = T.white
    knob.BorderSizePixel = 0
    knob.ZIndex = 2
    knob.Parent = track
    corner(knob, KS / 2)
    local knobEdge = stroke(knob, T.accent, 2)

    local cur = value
    local function paint()
        local txt, col
        if colorFn then txt, col = colorFn(cur) end
        val.Text = txt or (fmt and fmt(cur)) or tostring(cur)
        local c = col or T.green
        val.TextColor3 = c
        fill.BackgroundColor3 = c
        knobEdge.Color = c
        local t = math.clamp((cur - min) / (max - min), 0, 1)
        fill.Size = UDim2.new(t, 0, 1, 0)
        knob.Position = UDim2.new(t, 0, 0.5, 0)
    end
    paint()

    local function setFromX(absX)
        local tPos, tW = track.AbsolutePosition.X, track.AbsoluteSize.X
        if tW < 1 then return end
        local t = math.clamp((absX - tPos) / tW, 0, 1)
        local raw = min + t * (max - min)
        cur = math.clamp(math.floor(raw / stepv + 0.5) * stepv, min, max)
        paint()
        if cb then cb(cur) end
    end

    local sliding = false
    local function begin(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            setFromX(input.Position.X)
        end
    end
    track.InputBegan:Connect(begin)
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if not sliding then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            setFromX(input.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)

    return {
        Frame = f,
        Set = function(_, v) cur = math.clamp(v, min, max) paint() end,
        Get = function() return cur end,
    }
end

function Window:Button(label, cb)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 42)
    b.BackgroundColor3 = T.btnBg
    b.BackgroundTransparency = ToolUI.RowAlpha
    b.BorderSizePixel = 0
