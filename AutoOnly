local function normalizeServerRole(role)
    if type(role) ~= "string" then return nil end
    local r = role:lower()
    if r == "murderer" then return "Murderer"
    elseif r == "sheriff" or r == "hero" then return "Sheriff"
    elseif r == "innocent" then return "Innocent" end
    return nil
end
local function findServerEntry(player, data)
    if type(data) ~= "table" or not player then return nil end
    local e = data[player.Name]
    if type(e) == "table" then return e end
    e = data[player.UserId] or data[tostring(player.UserId)]
    if type(e) == "table" then return e end
    for _, v in pairs(data) do
        if type(v) == "table" and (v.UserId == player.UserId or v.Name == player.Name) then return v end
    end
    return nil
end
local function roleFromServerData(player)
    if not serverPlayerData then return nil end
    local entry = findServerEntry(player, serverPlayerData)
    if entry then return normalizeServerRole(entry.Role or entry.role) end
    return nil
end
task.spawn(function()
    pcall(function()
        local remotes  = ReplicatedStorage:WaitForChild("Remotes", 30)
        local gameplay = remotes and remotes:WaitForChild("Gameplay", 30)
        local fade     = gameplay and gameplay:WaitForChild("Fade", 30)
        if fade and fade:IsA("RemoteEvent") then
            fade.OnClientEvent:Connect(function(data)
                if type(data) ~= "table" then return end
                for _, v in pairs(data) do
                    if type(v) == "table" and (v.Role ~= nil or v.role ~= nil) then
                        serverPlayerData = data
                        roundEnded  = false
                        roundActive = true
                        return
                    end
                end
            end)
        end
        if gameplay then
            for _, name in ipairs({ "RoundEndFade", "RoundEnd", "GameEnd" }) do
                local ev = gameplay:FindFirstChild(name)
                if ev and ev:IsA("RemoteEvent") then
                    ev.OnClientEvent:Connect(function()
                        roundEnded  = true
                        roundActive = false
                        serverPlayerData = nil
                    end)
                end
            end
        end
    end)
end)
local function serverEntryFor(player)
    if not serverPlayerData then return nil end
    return findServerEntry(player, serverPlayerData)
end
local function getRole(player)
    if roundEnded then return "Lobby" end
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    local hasKnife = (char and char:FindFirstChild("Knife")) or (bp and bp:FindFirstChild("Knife"))
    local hasGun   = (char and char:FindFirstChild("Gun"))   or (bp and bp:FindFirstChild("Gun"))
    if hasKnife then return "Murderer" end
    if hasGun then return "Sheriff" end
    local fromServer = roleFromServerData(player)
    if fromServer then return fromServer end
    if roundActive or _weaponSeen then return "Innocent" end
    return "Lobby"
end
local function getPlayerByRole(role)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and getRole(plr) == role then return plr end
    end
    return nil
end

