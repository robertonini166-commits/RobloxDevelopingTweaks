local serverPlayerData = nil
local roundEnded  = false
local roundActive = false
local _weaponSeen = false
do
    local t = 0
    RunService.Heartbeat:Connect(function()
        t = t + 1
        if t < 15 then return end
        t = 0
        local found = false
        for _, plr in ipairs(Players:GetPlayers()) do
