-- Direct image link -> usable local asset (for the open-button logo).
local function loadCustomImage(url, slot)
    if type(url) ~= "string" or url == "" then return nil end
    local getCustom = getcustomasset or getsynasset
    if not (writefile and getCustom) then return nil end
    local okGet, data = pcall(function() return game:HttpGet(url, true) end)
    if not okGet or type(data) ~= "string" or data == "" then return nil end
    local ext = url:match("%.(%a%a%a%a?)%s*$") or "png"
    local path = "ToolScripts_AF_" .. (slot or "logo") .. "." .. ext
    if not pcall(writefile, path, data) then return nil end
    local okAsset, asset = pcall(getCustom, path)
    if okAsset and type(asset) == "string" and asset ~= "" then return asset end
    return nil
end
