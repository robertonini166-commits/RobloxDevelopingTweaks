-- ============================================================================
-- Animated border ramp. The gradient SPINS, so the first and last stop must be the
-- same colour: the old Deep -> Blue -> Cyan ramp put a hard seam on screen every
-- turn where 1.0 wrapped back to 0.0. Blue in both halves keeps the crossing clean.
local BORDER_GRADIENT = ColorSequence.new({
    ColorSequenceKeypoint.new(0,    LOGO.Deep),
    ColorSequenceKeypoint.new(0.25, LOGO.Blue),
    ColorSequenceKeypoint.new(0.5,  LOGO.Cyan),
    ColorSequenceKeypoint.new(0.75, LOGO.Blue),
    ColorSequenceKeypoint.new(1,    LOGO.Deep),
})
local BORDER_THICKNESS = 3

local windowCfg = {
    Title = "Tool Scripts · Autofarm",
    Icon = "solar:bolt-bold",
    Author = "MM2",
    Folder = "ToolScriptsAutofarm",
    Size = UDim2.fromOffset(440, 360),
    Theme = LOGO_THEME,
    SideBarWidth = 150,
    ToggleKey = Enum.KeyCode.RightShift,
    BorderGradient = BORDER_GRADIENT,
    BorderThickness = BORDER_THICKNESS,
}
local Window = WindUI:CreateWindow(windowCfg)

-- ---- ONE animated border, on the window's own edge (same fix as the spawner) --
-- The fork's ForkBorderStroke sits on UIElements.Main, which spans the exact window
-- bounds, so it is the only ring that should be visible; WindUI's native stroke and
-- the outer shadow stroke draw a SECOND ring right next to it. The fork also spins
-- the gradient it created at +2 deg per RenderStepped, so a second rotation driver
-- on the same object makes the colours strobe - swapping in our own gradient
-- retires the fork's loop (it runs `while gradient.Parent`) and leaves one writer.
local borderGrad
local function windowRoot()
    local main = Window and Window.UIElements and Window.UIElements.Main
    if not main then return nil end
    local n = main
    while n and n.Parent and n.Name ~= "Window" do n = n.Parent end
    return (n and n.Name == "Window") and n or nil
end
local function refreshWindowBorder()
    local main = Window and Window.UIElements and Window.UIElements.Main
    if not main then return end

    local stroke = main:FindFirstChild("ForkBorderStroke")
    if not stroke then
        -- Fork wrapper missing (upstream WindUI fallback): build the same stroke by
        -- hand, on Main itself so it hugs the window edge.
        stroke = Instance.new("UIStroke")
        stroke.Name = "ForkBorderStroke"
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        stroke.LineJoinMode = Enum.LineJoinMode.Round
        stroke.Parent = main
    end
    stroke.Transparency = 0
    stroke.Thickness = BORDER_THICKNESS
    stroke.Color = Color3.new(1, 1, 1)   -- white base: the gradient tints it

    local grad = stroke:FindFirstChild("AFBorderGrad")
    if not grad then
        for _, old in ipairs(stroke:GetChildren()) do
            if old:IsA("UIGradient") then old:Destroy() end
        end
        grad = Instance.new("UIGradient")
        grad.Name = "AFBorderGrad"
        grad.Parent = stroke
    end
    grad.Color = BORDER_GRADIENT
    borderGrad = grad
    pcall(function() Window:SetBorderGradient(BORDER_GRADIENT) end)
    pcall(function() Window:SetBorderThickness(BORDER_THICKNESS) end)

    local root = windowRoot()
    if not root then return end
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("UIStroke") and d ~= stroke then
            local g = d:FindFirstChildOfClass("UIGradient")
            if g then
                g.Color = BORDER_GRADIENT                    -- minimized pill etc.
            elseif d.Parent == main or not d:IsDescendantOf(main) then
                pcall(function() d.Transparency = 1 end)     -- second ring at the edge
            end
        end
    end
    for _, d in ipairs(root:GetChildren()) do
        if d ~= main and d:IsA("GuiObject") and d.Name:lower():find("shadow") then
            pcall(function() d.Visible = false end)
        end
    end
end
-- The fork builds its chrome asynchronously, so retry instead of running once.
task.defer(refreshWindowBorder)
task.delay(0.25, refreshWindowBorder)
task.delay(0.75, refreshWindowBorder)
task.delay(1.5, refreshWindowBorder)

-- Single slow driver: 18 deg/s = one turn every 20s, same pace as the spawner.
task.spawn(function()
    while Window and not Window.Destroyed do
        if borderGrad then
            local r = (os.clock() * 18) % 360
            pcall(function() borderGrad.Rotation = r end)
        end
        task.wait(1 / 30)
    end
end)

-- The border lives on Main, which stays visible when the window is minimized -
-- without this it lingers on screen as an empty rectangle.
pcall(function()
    local main = Window.UIElements and Window.UIElements.Main
    local inner = main and main:FindFirstChild("Main")
    if not inner then return end
    inner:GetPropertyChangedSignal("Visible"):Connect(function()
        main.Visible = inner.Visible
    end)
end)

pcall(function()
    Window:EditOpenButton({
